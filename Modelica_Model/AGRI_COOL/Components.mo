  </li>
  <li>
    <i>July 4, 2013&#160;</i> by Ole Odendahl:<br/>
    Added documentation and formatted appropriately
  </li>
</ul>
</html>"));
          end StorageDetailedBaseDataDefinition;
        end Storage;

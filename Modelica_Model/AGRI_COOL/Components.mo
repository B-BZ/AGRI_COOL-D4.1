          end Test_CTRL1;

          model Controller2
            parameter Real T_Threshold = 1 "Temperature difference threshold for activation";
            parameter Real Transfer_Time=10 "the time in which all the mass from tank 1 transfers to tank 2";
            Modelica.Blocks.Interfaces.RealInput T1
              annotation (Placement(transformation(extent={{-126,40},{-86,80}})));
            Modelica.Blocks.Interfaces.RealInput T2
              annotation (Placement(transformation(extent={{-126,-2},{-86,38}})));
            Modelica.Blocks.Interfaces.RealInput m
              annotation (Placement(transformation(extent={{-128,-80},{-88,-40}})));
            Modelica.Blocks.Interfaces.RealOutput FlowSignal
              annotation (Placement(transformation(extent={{96,-10},{116,10}})));
            Modelica.Blocks.Logical.LessEqualThreshold lessEqualThreshold(threshold=
                  T_Threshold)
              annotation (Placement(transformation(extent={{0,30},{20,50}})));
            Modelica.Blocks.Math.Add TempDiff(k2=-1)
              annotation (Placement(transformation(extent={{-44,30},{-24,50}})));
            Modelica.Blocks.Logical.Switch switch1
              annotation (Placement(transformation(extent={{52,-70},{72,-50}})));
            Modelica.Blocks.Sources.Constant ZeroFlow(k=0) annotation (Placement(
                  transformation(
                  extent={{-10,-10},{10,10}},
                  rotation=270,
                  origin={66,2})));

            Modelica.Blocks.Logical.GreaterThreshold hasMass(threshold=0.001)
              annotation (Placement(transformation(extent={{-44,-70},{-24,-50}})));
            Modelica.Blocks.Logical.Timer timer
              annotation (Placement(transformation(extent={{6,-14},{26,6}})));
            Modelica.Blocks.Logical.And transferCondition
              annotation (Placement(transformation(extent={{0,-50},{20,-30}})));
          // Discrete variable for storing initial mass at the start of transfer
            discrete Real m_start;
            Real a;
            Modelica.Blocks.Math.Product product1
              annotation (Placement(transformation(extent={{22,-98},{42,-78}})));
            Modelica.Blocks.Sources.RealExpression realExpression(y=a)
              annotation (Placement(transformation(extent={{-90,-102},{-70,-82}})));
          equation
            // Capture initial mass when transfer starts
            when lessEqualThreshold.y then
              m_start = pre(m);
            end when;
            // Compute flow rate coefficient
            a = 2 * m_start / (Transfer_Time^2);

            connect(T1, TempDiff.u1) annotation (Line(points={{-106,60},{-52,60},{-52,46},
                    {-46,46}}, color={0,0,127}));
            connect(T2, TempDiff.u2) annotation (Line(points={{-106,18},{-52,18},{-52,34},
                    {-46,34}}, color={0,0,127}));
            connect(TempDiff.y, lessEqualThreshold.u)
              annotation (Line(points={{-23,40},{-2,40}}, color={0,0,127}));
            connect(switch1.y, FlowSignal) annotation (Line(points={{73,-60},{92,-60},{92,
                    0},{106,0}}, color={0,0,127}));
            connect(ZeroFlow.y, switch1.u3) annotation (Line(points={{66,-9},{
                    66,-42},{42,-42},{42,-68},{50,-68}},
                                                      color={0,0,127}));
            connect(m, hasMass.u)
              annotation (Line(points={{-108,-60},{-46,-60}}, color={0,0,127}));
            connect(lessEqualThreshold.y, transferCondition.u1) annotation (Line(points={{
                    21,40},{32,40},{32,-28},{-14,-28},{-14,-40},{-2,-40}}, color={255,0,255}));
            connect(hasMass.y, transferCondition.u2) annotation (Line(points={{-23,-60},{-10,
                    -60},{-10,-48},{-2,-48}}, color={255,0,255}));
            connect(transferCondition.y, switch1.u2) annotation (Line(points={{21,-40},{32,
                    -40},{32,-60},{50,-60}}, color={255,0,255}));
            connect(timer.y, product1.u1) annotation (Line(points={{27,-4},{30,-4},{30,-66},
                    {20,-66},{20,-82}}, color={0,0,127}));
            connect(realExpression.y, product1.u2)
              annotation (Line(points={{-69,-92},{12,-92},{12,-94},{20,-94}},
                                                                    color={0,0,127}));
            connect(lessEqualThreshold.y, timer.u) annotation (Line(points={{21,40},{28,40},
                    {28,8},{-6,8},{-6,-4},{4,-4}}, color={255,0,255}));
            connect(product1.y, switch1.u1) annotation (Line(points={{43,-88},{44,
                    -88},{44,-52},{50,-52}}, color={0,0,127}));
            annotation (Icon(coordinateSystem(preserveAspectRatio=false), graphics={
                    Rectangle(
                    extent={{-100,100},{100,-100}},
                    lineColor={28,108,200},
                    fillColor={255,255,255},
                    fillPattern=FillPattern.Solid), Text(
                    extent={{-70,46},{62,-42}},
                    textColor={28,108,200},
                    textString="Controller")}), Diagram(coordinateSystem(
                    preserveAspectRatio=false)));
          end Controller2;

          model Test_CTRL2

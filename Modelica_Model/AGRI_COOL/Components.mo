              textString="Equipment Load")}));
    end equipmentLoad;

    model supCapDis
      parameter Real capacityModule = 1000 "each super Cap capacity [F]";
      parameter Real moduleNumber = 4 "No.";
      parameter Real capacityTotal = 4*capacityModule "Total capacity [F]";
      parameter Real Vmin_100 = 42 "Equipment undervoltage cutoff at 100% DOD [V]";
      parameter Real Vmax = 58 "Overvoltage stop [V]";
      parameter Real Vnom = 51.8 "Max charge current [V]";

      parameter Real DOD = 75 "depth of discharge [%]";
      parameter Real Vmin = sqrt(Vmax^2 - ((DOD/100)* (Vmax^2 - Vmin_100^2)))
      "Equipment undervoltage cutoff computed from DOD [V]";
      parameter Real Imax = 400 "Max charge current [A]";
      Modelica.Electrical.Batteries.BatteryStacks.SuperCap superCap(
        Vnom=Vnom,
        V0=Vmax,
        C=capacityTotal,
        Rs=0.002,
        Idis=0.05,
        useHeatPort=false)
        annotation (Placement(transformation(extent={{-10,10},{10,-10}}, origin={432,-142})));
      Modelica.Electrical.Analog.Basic.Ground ground
        annotation (Placement(transformation(extent={{378,-302},{398,-282}})));
      Modelica.Electrical.Analog.Sources.SignalCurrent iSrcPV
        annotation (Placement(transformation(extent={{10,-10},{-10,10}}, rotation=90, origin={230,-178})));
      Modelica.Electrical.Analog.Sources.SignalCurrent iSinkLoad
        annotation (Placement(transformation(extent={{10,-10},{-10,10}}, rotation=180, origin={292,-174})));
      Modelica.Electrical.Analog.Sensors.PowerSensor powerSensor
        annotation (Placement(transformation(extent={{356,-154},{376,-134}})));
      Modelica.Blocks.Continuous.Integrator energy(
        initType=Modelica.Blocks.Types.Init.InitialState,
                                                   u(unit="W"), y(unit="J"))
        annotation (Placement(transformation(extent={{6,-6},{-6,6}},     origin={242,-130})));
      Modelica.Electrical.Analog.Sensors.VoltageSensor vCap(v(start=Vnom, fixed
            =false))
        annotation (Placement(transformation(extent={{-10,-10},{10,10}}, origin={412,-182})));
      Modelica.Blocks.Nonlinear.Limiter vFloor(uMin=5, uMax=1e6)
        annotation (Placement(transformation(extent={{-10,-10},{10,10}}, origin={406,-78})));
      Modelica.Blocks.Nonlinear.Limiter pLim(uMin=0, uMax=1e9)
        annotation (Placement(transformation(extent={{168,-70},{188,-50}})));
      Modelica.Blocks.Sources.Constant eta_AC2DC(k=0.95) "Converter efficiency"
        annotation (Placement(transformation(extent={{310,-60},{330,-40}})));
      Modelica.Blocks.Math.Add pvMinusLoad(k1=+1, k2=-1)
        annotation (Placement(transformation(extent={{-10,-10},{10,10}}, origin={242,-88})));
      Modelica.Blocks.Nonlinear.Limiter pSurLim(uMin=0, uMax=1e9)
        annotation (Placement(transformation(extent={{-10,-10},{10,10}}, origin={306,-88})));
      Modelica.Blocks.Math.Product pEff
        annotation (Placement(transformation(extent={{-10,-10},{10,10}}, origin={358,-102})));
      Modelica.Blocks.Math.Division pOverV
        annotation (Placement(transformation(extent={{-10,-10},{10,10}}, origin={478,-80})));
      Modelica.Blocks.Nonlinear.Limiter iLim(uMin=0, uMax=Imax)
        annotation (Placement(transformation(extent={{-10,-10},{10,10}}, origin={510,-100})));
      Modelica.Blocks.Sources.Constant zero(k=0)
        annotation (Placement(transformation(extent={{-10,-10},{10,10}}, origin={502,-184})));
      Modelica.Blocks.Logical.Switch iEnable
        annotation (Placement(transformation(extent={{-10,-10},{10,10}}, origin={560,-136})));
      Modelica.Blocks.Math.Gain iPVNeg(k=-1) "Make it a sink (negative into bus)"
        annotation (Placement(transformation(extent={{10,-10},{-10,10}}, origin={506,-234})));
      Modelica.Electrical.Analog.Sensors.PowerSensor powerSensor1
        annotation (Placement(transformation(extent={{310,-214},{330,-194}})));
      Modelica.Blocks.Math.Add SumEnergy annotation (Placement(transformation(
              extent={{6,-6},{-6,6}}, origin={298,-130})));
      Modelica.Blocks.Logical.Hysteresis hysteresis(
        uLow=Vmax - 10,
        uHigh=Vmax,
        y(start=true, fixed=false))

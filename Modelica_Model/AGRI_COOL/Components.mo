    end People;

    package Product_Load "The package that calculates the product heat load."

      package Sensible
        package Connectors
          connector Crop_Inflow
            input Modelica.Units.SI.MassFlowRate m_flow;
            input Modelica.Units.SI.Temperature T "Temperature [K]";
            input Modelica.Units.SI.EnthalpyFlowRate H_flow;
            annotation (Icon(coordinateSystem(preserveAspectRatio=false), graphics={
                    Polygon(
                    points={{-100,40},{0,0},{-100,-42},{-100,40}},
                    lineColor={0,140,72},
                    fillColor={0,140,72},
                    fillPattern=FillPattern.Solid)}),                      Diagram(
                  coordinateSystem(preserveAspectRatio=false)));
          end Crop_Inflow;

          connector Crop_Outflow
            output Modelica.Units.SI.MassFlowRate m_flow;
            output Modelica.Units.SI.Temperature T "Temperature [K]";
            output Modelica.Units.SI.EnthalpyFlowRate H_flow;
            annotation (Icon(coordinateSystem(preserveAspectRatio=false), graphics={
                    Polygon(
                    points={{-100,40},{4,-2},{-100,-42},{-100,40}},
                    lineColor={0,140,72},
                    lineThickness=1)}),                                    Diagram(
                  coordinateSystem(preserveAspectRatio=false)));
          end Crop_Outflow;
        end Connectors;

        package Components
          model CropSourcee
            parameter Real cp(unit = "J/(kg.K)") = 3500 "Specific heat capacity [J/(kg.K)]";
            parameter Modelica.Units.SI.Temperature T=273.15+25 "Temperature [K]";
            Sensible.Connectors.Crop_Outflow crop_Outflow annotation (Placement(
                  transformation(extent={{92,-22},{128,22}}),
                  iconTransformation(extent={{92,-22},{128,22}})));

            Modelica.Blocks.Interfaces.RealInput m(  unit = "kg/s")
              annotation (Placement(transformation(extent={{-112,-12},{-90,10}}),
                  iconTransformation(extent={{-112,-12},{-90,10}})));
          equation
            crop_Outflow.T = T;
            crop_Outflow.m_flow = m;
            crop_Outflow.H_flow = m * cp * T;
          assert(m >= 0, "Mass flow rate must be non-negative.");
          assert(T >= 190 and T <= 350, "Temperature is out of expected range.");
            // Relating Crop_Outflow parameters to corresponding values
            // Convert T to Kelvin for H_flow calculation
              annotation (Placement(transformation(extent={{-128,-20},{-88,20}})),
                        Icon(coordinateSystem(preserveAspectRatio=false),
                  graphics={Bitmap(
                    extent={{-136,-80},{134,80}},
                    imageSource=
                        "",
                    fileName=
                        "modelica://AGRI_COOL/AGRICOOL/Icons/CropSource_Icon.png")}),
                                                      Diagram(coordinateSystem(
                    preserveAspectRatio=false)));
          end CropSourcee;

          model Tank
          // Parameters
            parameter Modelica.Units.SI.Mass m_Initial=20;
            parameter Modelica.Units.SI.Temperature T_Initial = 25+273.15 "Initial temperature [degC]";
            parameter Modelica.Units.SI.SpecificHeatCapacity cp = 3500 "Specific heat capacity (assumed constant)";
            parameter Modelica.Units.SI.Mass m_min = 0.001 "Minimum mass for stability [kg]";
            parameter Modelica.Units.SI.MassFlowRate m_flow_min = 0.00000001
              "Minimum inflow rate to consider for dynamic enthalpy calculation";

            // States
            Modelica.Units.SI.Mass m(start = m_Initial, min=0);
            Modelica.Units.SI.Enthalpy H(start = m_Initial * cp * T_Initial);
            Modelica.Units.SI.Temperature T(start = T_Initial) "Temperature [K]";

            Sensible.Connectors.Crop_Inflow crop_Inflow annotation (Placement(
                  transformation(extent={{-104,60},{-84,80}})));
            Sensible.Connectors.Crop_Outflow crop_Outflow
              annotation (Placement(transformation(extent={{96,60},{116,80}})));
            Modelica.Blocks.Interfaces.RealInput Flow_signal annotation (Placement(
                  transformation(extent={{-114,-64},{-92,-42}}), iconTransformation(
                    extent={{-114,-64},{-92,-42}})));
            Modelica.Thermal.HeatTransfer.Interfaces.HeatPort_a Heat
              annotation (Placement(transformation(extent={{-10,-110},{10,-90}})));
            Modelica.Blocks.Interfaces.RealOutput Sensor_m
              annotation (Placement(transformation(extent={{96,-34},{116,-14}})));
            Modelica.Blocks.Interfaces.RealOutput Sensor_T
              annotation (Placement(transformation(extent={{96,-58},{116,-38}})));

          equation
            // Mass Balance: Prevent singularity issues when mass flow is near zero
            //   der(m) = if abs(crop_Inflow.m_flow) > m_flow_min or abs(crop_Outflow.m_flow) > m_flow_min then
            //              crop_Inflow.m_flow - crop_Outflow.m_flow
            //            else 0;
          der(m) = crop_Inflow.m_flow - crop_Outflow.m_flow;
            // Energy Balance: Only consider significant inflows
            //   der(H) = if abs(crop_Inflow.m_flow) > m_flow_min then
            //              crop_Inflow.m_flow * cp * crop_Inflow.T
            //            else 0
            //            - crop_Outflow.m_flow * cp * T
            //            + Heat.Q_flow;
          der(H) = crop_Inflow.m_flow * cp * crop_Inflow.T
                 - crop_Outflow.m_flow * cp * T
                 + Heat.Q_flow;                             // Energy from inflow
            // Energy lost via outflow
            // External heat input
            // Temperature Calculation (Avoid division by zero)
            T = H / (max(m, m_min) * cp);
            //H = m*cp*T;
            // Output Signals
            Sensor_T = T;
            Sensor_m = m;
            // Connect Outputs
            crop_Outflow.T = T;
            crop_Outflow.m_flow = Flow_signal;
            crop_Outflow.H_flow = crop_Outflow.m_flow * cp * crop_Outflow.T;
            Heat.T = T;

            annotation (Icon(coordinateSystem(preserveAspectRatio=false), graphics={
                    Bitmap(
                    extent={{-102,-96},{104,98}},
                    imageSource="",
                    fileName=
                        "modelica://AGRI_COOL/AGRICOOL/Icons/Crop_tank_Icon.png")}),
                Diagram(coordinateSystem(preserveAspectRatio=false)));
          end Tank;

          model Controller
            parameter Real T_Threshold = 1 "Temperature difference threshold for activation";
            parameter Real Transfer_Time=0.000001 "the time in which all the mass from tank 1 transfers to tank 2";
            Modelica.Blocks.Interfaces.RealInput T1
              annotation (Placement(transformation(extent={{-126,40},{-86,80}})));
            Modelica.Blocks.Interfaces.RealInput T2
              annotation (Placement(transformation(extent={{-126,-2},{-86,38}})));
            Modelica.Blocks.Interfaces.RealInput m
              annotation (Placement(transformation(extent={{-128,-80},{-88,-40}})));
            Modelica.Blocks.Interfaces.RealOutput FlowSignal
              annotation (Placement(transformation(extent={{96,-10},{116,10}})));
            Modelica.Blocks.Logical.LessEqualThreshold lessEqualThreshold(threshold=
                  T_Threshold)
              annotation (Placement(transformation(extent={{0,30},{20,50}})));
            Modelica.Blocks.Math.Add TempDiff(k2=-1)
              annotation (Placement(transformation(extent={{-44,30},{-24,50}})));
            Modelica.Blocks.Logical.Switch switch1
              annotation (Placement(transformation(extent={{52,-70},{72,-50}})));
            Modelica.Blocks.Sources.Constant const(k=0) annotation (Placement(
                  transformation(
                  extent={{-10,-10},{10,10}},
                  rotation=270,
                  origin={58,0})));
            Modelica.Blocks.Math.Division division
              annotation (Placement(transformation(extent={{-36,-70},{-16,-50}})));
            Modelica.Blocks.Sources.Constant const1(k=Transfer_Time)
                                                        annotation (Placement(
                  transformation(
                  extent={{-10,-10},{10,10}},
                  rotation=0,
                  origin={-66,-80})));
          equation
            connect(T1, TempDiff.u1) annotation (Line(points={{-106,60},{-52,60},{-52,46},
                    {-46,46}}, color={0,0,127}));
            connect(T2, TempDiff.u2) annotation (Line(points={{-106,18},{-52,18},{-52,34},
                    {-46,34}}, color={0,0,127}));
            connect(TempDiff.y, lessEqualThreshold.u)
              annotation (Line(points={{-23,40},{-2,40}}, color={0,0,127}));
            connect(lessEqualThreshold.y, switch1.u2) annotation (Line(points={{21,40},{40,
                    40},{40,-60},{50,-60}}, color={255,0,255}));
            connect(switch1.y, FlowSignal) annotation (Line(points={{73,-60},{92,-60},{92,
                    0},{106,0}}, color={0,0,127}));
            connect(m, division.u1) annotation (Line(points={{-108,-60},{-48,-60},{-48,-54},
                    {-38,-54}}, color={0,0,127}));
            connect(const1.y, division.u2) annotation (Line(points={{-55,-80},{-46,-80},{-46,
                    -66},{-38,-66}}, color={0,0,127}));
            connect(const.y, switch1.u3) annotation (Line(points={{58,-11},{44,-11},{44,-16},
                    {26,-16},{26,-68},{50,-68}}, color={0,0,127}));
            connect(division.y, switch1.u1) annotation (Line(points={{-15,-60},{32,-60},{32,
                    -52},{50,-52}}, color={0,0,127}));
            annotation (Icon(coordinateSystem(preserveAspectRatio=false), graphics={
                    Rectangle(
                    extent={{-100,100},{100,-100}},
                    lineColor={28,108,200},
                    fillColor={255,255,255},
                    fillPattern=FillPattern.Solid), Text(
                    extent={{-70,46},{62,-42}},
                    textColor={28,108,200},
                    textString="Controller")}), Diagram(coordinateSystem(
                    preserveAspectRatio=false)));
          end Controller;

          model Test_CTRL
            Controller controller
              annotation (Placement(transformation(extent={{-12,30},{8,50}})));
            Modelica.Blocks.Sources.Constant const(k=10)
              annotation (Placement(transformation(extent={{-50,40},{-30,60}})));

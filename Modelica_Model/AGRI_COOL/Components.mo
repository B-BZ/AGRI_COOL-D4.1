            Tank_enthalpy
                 tank_enthalpy(
              m_Initial=m_Initial_T1,
              T_Initial=T_Initial_T1,
              cp=cp_T1)
              annotation (Placement(transformation(extent={{-26,22},{-6,42}})));
            Tank_enthalpy
                 tank_enthalpy1(
              m_Initial=m_Initial_T2,
              T_Initial=T_Initial_T2,
              cp=cp_T2)
              annotation (Placement(transformation(extent={{26,4},{46,24}})));
            Controller2 controller2(T_Threshold=T_Threshold, Transfer_Time=
                  Transfer_Time)
              annotation (Placement(transformation(extent={{-8,-18},{12,2}})));
            Modelica.Thermal.HeatTransfer.Components.ThermalConductor
              thermalConductor(G=G_tank1)
              annotation (Placement(transformation(extent={{-36,4},{-56,24}})));
            Modelica.Thermal.HeatTransfer.Components.ThermalConductor
              thermalConductor1(G=G_Tank2)

              radius=25.0),
            Text(
              extent={{-88,62},{86,-48}},
              textColor={255,255,255},
              textString="Aix",
              textStyle={TextStyle.Bold})}));
    end AixLib;

    model AixLib_Fluid_Storage_StorageDetailed
      import AGRI_COOL.Components.Decoupler_Tank.AixLib;
     extends AixLib.Fluid.Storage.StorageDetailed;
      annotation(experiment(
        StopTime=1,
        __Dymola_NumberOfIntervals=500,
        Tolerance=0.0001,
        __Dymola_Algorithm="dassl"));
    end AixLib_Fluid_Storage_StorageDetailed;
  end Decoupler_Tank;

  package LTES
    package Physics_based "Physiscs based descritized model for LTES tank"

      model HeatCapacitorPCM
        "Lumped thermal element storing thermal energy with phase change"
        parameter Modelica.Units.SI.Length H=0.155 "height of Cell";
        parameter Modelica.Units.SI.Length L=1 "width of Cell";
        parameter Modelica.Units.SI.Length th=0.0155 "thickness of Cell";
        parameter Modelica.Units.SI.Area A=H*L "Heat Transfer Area";
        parameter Modelica.Units.SI.Volume V=H*L*th "Volume of Cell";
        parameter Modelica.Units.SI.Density Rho_w=999.8 "Density of Water";
        parameter Modelica.Units.SI.Density Rho_ice=916.63 "Density of Water";
        parameter Modelica.Units.SI.Mass m=V*Rho_w "mass of water inside the Cell";
        parameter Modelica.Units.SI.SpecificHeatCapacity C_w=4180
          "Specific heat capacity of water";
        parameter Modelica.Units.SI.SpecificHeatCapacity C_ice=2217
          "Specific heat capacity of water";
        parameter Modelica.Units.SI.Temperature T_s=272.85 "Solidus Temperature";
        parameter Modelica.Units.SI.Temperature T_l=273.15 "melt temperature";
        parameter Modelica.Units.SI.SpecificEnergy h_sl=334000
          "latent heat of melting";
        parameter Modelica.Units.SI.SpecificHeatCapacity C_melt=h_sl/(T_l - T_s)
          "Effective heat capacity in melting zone (J/kg·K)";
        // State Variables
        Modelica.Units.SI.Temperature T(start=274.15, displayUnit="degC")
          "Temperature of PCM";
        Modelica.Units.SI.SpecificHeatCapacity Cp "Effective heat capacity";
        Modelica.Thermal.HeatTransfer.Interfaces.HeatPort_a port annotation (
            Placement(transformation(
              origin={0,-100},
              extent={{-10,-10},{10,10}},
              rotation=90)));
        Modelica.Blocks.Interfaces.RealOutput liquidFraction
          "Fraction of PCM in liquid state (0=solid, 1=liquid)" annotation (Placement(
              transformation(
              extent={{-10,-10},{10,10}},
              rotation=90,
              origin={0,106})));
      equation
        // Port temperature
        T = port.T;

        Cp = if noEvent(T < T_s) then C_ice else if noEvent(T > T_l) then C_w else C_melt;
        // Linear liquid fraction
        liquidFraction = if noEvent(T <= T_s) then 0 else if noEvent(T >= T_l) then 1 else (T - T_s)/(
          T_l - T_s);
        // Heat balance equation
        m*Cp*der(T) = port.Q_flow;
        annotation (Icon(coordinateSystem(preserveAspectRatio=false), graphics={
                                         Polygon(
                points={{2,81},{-18,77},{-38,71},{-50,57},{-56,49},{-66,39},{-70,27},{
                    -74,13},{-76,-1},{-74,-17},{-74,-29},{-74,-39},{-68,-51},{-62,-59},
                    {-46,-63},{-28,-69},{-16,-69},{0,-71},{10,-75},{24,-75},{34,-73},{
                    44,-67},{56,-61},{58,-59},{68,-47},{70,-39},{72,-37},{74,-21},{78,
                    -7},{80,1},{80,17},{76,29},{68,39},{56,47},{46,55},{38,71},{28,79},
                    {2,81}},
                lineColor={160,160,164},
                fillColor={85,170,255},
                fillPattern=FillPattern.CrossDiag), Polygon(
                points={{-56,49},{-66,39},{-70,27},{-74,13},{-76,-1},{-74,-17},{-74,-29},
                    {-74,-39},{-68,-51},{-62,-59},{-46,-63},{-28,-69},{-16,-69},{0,-71},
                    {10,-75},{24,-75},{34,-73},{44,-67},{56,-61},{44,-63},{42,-63},{32,
                    -65},{22,-67},{20,-67},{12,-67},{4,-63},{-10,-59},{-20,-59},{-28,-57},
                    {-38,-51},{-48,-41},{-54,-29},{-56,-21},{-56,-11},{-58,1},{-58,9},
                    {-58,21},{-56,31},{-54,33},{-50,41},{-46,49},{-42,59},{-38,71},{-56,
                    49}},
                fillColor={28,108,200},
                fillPattern=FillPattern.Solid)}), Diagram(coordinateSystem(
                preserveAspectRatio=false)));
      end HeatCapacitorPCM;

      model ThermalConductorPCM
        "Thermal conductor with phase-dependent conductance based on liquid fraction"

        // Parameters for Geometry
        parameter Modelica.Units.SI.Area A=0.0155*1 "Cross-sectional area [m²]";
        parameter Modelica.Units.SI.Length d "Thickness of material [m]";

        // Thermal Conductivity for Water and Ice
        parameter Modelica.Units.SI.ThermalConductivity k_ice = 1.918
          "Thermal conductivity of ice [W/(m·K)]";
        parameter Modelica.Units.SI.ThermalConductivity k_water = 0.518
          "Thermal conductivity of water [W/(m·K)]";

        // **Real input for liquid fraction (0 = solid, 1 = liquid)**
        Modelica.Blocks.Interfaces.RealInput liquidFraction annotation (
            Placement(transformation(
              extent={{-20,-20},{20,20}},
              rotation=270,
              origin={-2,106})));

        // Heat Transfer Interfaces
        Modelica.Thermal.HeatTransfer.Interfaces.HeatPort_a port_a annotation (
            Placement(transformation(extent={{-110,-10},{-90,10}})));
        Modelica.Thermal.HeatTransfer.Interfaces.HeatPort_b port_b annotation (
            Placement(transformation(extent={{90,-10},{110,10}})));

        // **Effective Thermal Conductance**
        Modelica.Units.SI.ThermalConductance G "Thermal conductance [W/K]";

      equation
        // **Linear interpolation for effective thermal conductivity**
        G = ((1 - liquidFraction) * k_ice + liquidFraction * k_water) * A /(0.5*d);
        // **Heat transfer equation**
        port_a.Q_flow + port_b.Q_flow = 0;
        port_a.Q_flow = G * (port_a.T - port_b.T);
        annotation (Icon(coordinateSystem(preserveAspectRatio=false), graphics={
              Rectangle(
                extent={{-90,74},{90,-66}},
                pattern=LinePattern.None,
                fillColor={28,108,200},
                fillPattern=FillPattern.Backward)}),                   Diagram(
              coordinateSystem(preserveAspectRatio=false)));
      end ThermalConductorPCM;

      model disc1D_element
        parameter Modelica.Units.SI.Length L_cell "length of cell";
        parameter Modelica.Units.SI.Length W_cell "width of cell";
        parameter Modelica.Units.SI.Length d "thickness of cell";
        parameter Modelica.Units.SI.Area A_HT=L_cell*W_cell  "Heat Transfer Area";
        parameter Modelica.Units.SI.Temperature T_start=274.15 "Initial Temperature of PCM";
        AGRI_COOL.Components.LTES.Physics_based.HeatCapacitorPCM heatCapacitorPCM(
          H=L_cell,
          L=W_cell,
          th=d,
          A=A_HT,
          T(start=T_start, fixed=true))
          annotation (Placement(transformation(extent={{-10,16},{10,36}})));
        AGRI_COOL.Components.LTES.Physics_based.ThermalConductorPCM pCMThermalConductor(A=A_HT, d
            =d) annotation (Placement(transformation(extent={{-60,-10},{-40,10}})));
        Modelica.Thermal.HeatTransfer.Interfaces.HeatPort_a port_L
          annotation (Placement(transformation(extent={{-112,-10},{-92,10}})));
        Modelica.Thermal.HeatTransfer.Interfaces.HeatPort_a port_R
          annotation (Placement(transformation(extent={{90,-10},{110,10}})));

        AGRI_COOL.Components.LTES.Physics_based.ThermalConductorPCM pCMThermalConductor3(A=A_HT, d
            =d) annotation (Placement(transformation(extent={{56,-10},{36,10}})));
        Modelica.Blocks.Interfaces.RealOutput LF_Cell
          "Fraction of PCM in liquid state (0=solid, 1=liquid)" annotation (
            Placement(transformation(
              extent={{-10,-10},{10,10}},
              rotation=90,
              origin={-58,102})));
        Modelica.Thermal.HeatTransfer.Sensors.TemperatureSensor
          temperatureSensor
          annotation (Placement(transformation(extent={{18,54},{38,74}})));
        Modelica.Blocks.Interfaces.RealOutput T_Cell
          "Absolute temperature as output signal" annotation (Placement(
              transformation(
              extent={{-10,-10},{10,10}},
              rotation=90,
              origin={60,104})));
      equation
        connect(heatCapacitorPCM.liquidFraction, pCMThermalConductor.liquidFraction)
          annotation (Line(points={{0,36.6},{0,44},{-50.2,44},{-50.2,10.6}}, color={0,
                0,127}));
        connect(heatCapacitorPCM.port, pCMThermalConductor.port_b)
          annotation (Line(points={{0,16},{0,0},{-40,0}}, color={191,0,0}));
        connect(pCMThermalConductor.port_a,port_L)
          annotation (Line(points={{-60,0},{-102,0}}, color={191,0,0}));
        connect(heatCapacitorPCM.port, pCMThermalConductor3.port_b)
          annotation (Line(points={{0,16},{0,0},{36,0}}, color={191,0,0}));
        connect(pCMThermalConductor3.port_a, port_R)
          annotation (Line(points={{56,0},{100,0}}, color={191,0,0}));
        connect(heatCapacitorPCM.liquidFraction, pCMThermalConductor3.liquidFraction)
          annotation (Line(points={{0,36.6},{0,44},{46.2,44},{46.2,10.6}}, color={0,0,
                127}));
        connect(heatCapacitorPCM.liquidFraction, LF_Cell) annotation (Line(
              points={{0,36.6},{-30,36.6},{-30,70},{-58,70},{-58,102}}, color
              ={0,0,127}));
        connect(heatCapacitorPCM.port, temperatureSensor.port) annotation (
            Line(points={{0,16},{12,16},{12,18},{18,18},{18,64}}, color={191,
                0,0}));
        connect(temperatureSensor.T, T_Cell) annotation (Line(points={{39,64},
                {60,64},{60,104}}, color={0,0,127}));
        annotation (Icon(coordinateSystem(preserveAspectRatio=false), graphics={
                Rectangle(extent={{-80,80},{20,-80}}, lineColor={28,108,200}),
                Rectangle(extent={{20,80},{80,-80}}, lineColor={95,95,95})}),
                                                                       Diagram(
              coordinateSystem(preserveAspectRatio=false)));
      end disc1D_element;

      model disc1D_element_2DHT
        AGRI_COOL.Components.LTES.Physics_based.HeatCapacitorPCM heatCapacitorPCM(
          th=d,
          A_HTF=A,
          T(start=T_start, fixed=true))
          annotation (Placement(transformation(extent={{-10,16},{10,36}})));
        AGRI_COOL.Components.LTES.Physics_based.ThermalConductorPCM pCMThermalConductor(A=A, d=d)
          annotation (Placement(transformation(extent={{-60,-10},{-40,10}})));
        Modelica.Thermal.HeatTransfer.Interfaces.HeatPort_a port_L
          annotation (Placement(transformation(extent={{-112,-10},{-92,10}})));
        Modelica.Thermal.HeatTransfer.Interfaces.HeatPort_a port_R
          annotation (Placement(transformation(extent={{90,-10},{110,10}})));
        parameter Modelica.Units.SI.Area A=heatCapacitorPCM.H*heatCapacitorPCM.L
          "Heat Transfer Area";
        parameter Modelica.Units.SI.Length d=0.0155 "thickness of plate";
        parameter Modelica.Units.SI.Temperature T_start=274.15 "Temperature of PCM";
        AGRI_COOL.Components.LTES.Physics_based.ThermalConductorPCM pCMThermalConductor1(A=A, d=d)
          annotation (Placement(transformation(
              extent={{-10,-10},{10,10}},
              rotation=270,
              origin={0,70})));
        AGRI_COOL.Components.LTES.Physics_based.ThermalConductorPCM pCMThermalConductor2(A=A, d=d)
          annotation (Placement(transformation(
              extent={{-10,-10},{10,10}},
              rotation=90,
              origin={0,-40})));
        AGRI_COOL.Components.LTES.Physics_based.ThermalConductorPCM pCMThermalConductor3(A=A, d=d)
          annotation (Placement(transformation(extent={{56,-10},{36,10}})));
        Modelica.Thermal.HeatTransfer.Interfaces.HeatPort_a port_T
          annotation (Placement(transformation(extent={{-10,92},{10,112}})));
        Modelica.Thermal.HeatTransfer.Interfaces.HeatPort_a port_B
          annotation (Placement(transformation(extent={{-10,-110},{10,-90}})));
      equation
        connect(heatCapacitorPCM.liquidFraction, pCMThermalConductor.liquidFraction)
          annotation (Line(points={{0,36.6},{0,44},{-50.2,44},{-50.2,10.6}}, color={0,
                0,127}));
        connect(heatCapacitorPCM.port, pCMThermalConductor.port_b)
          annotation (Line(points={{0,16},{0,0},{-40,0}}, color={191,0,0}));
        connect(pCMThermalConductor.port_a,port_L)
          annotation (Line(points={{-60,0},{-102,0}}, color={191,0,0}));
        connect(heatCapacitorPCM.port, pCMThermalConductor3.port_b)
          annotation (Line(points={{0,16},{0,0},{36,0}}, color={191,0,0}));
        connect(pCMThermalConductor3.port_a, port_R)
          annotation (Line(points={{56,0},{100,0}}, color={191,0,0}));
        connect(heatCapacitorPCM.liquidFraction, pCMThermalConductor3.liquidFraction)
          annotation (Line(points={{0,36.6},{0,44},{46.2,44},{46.2,10.6}}, color={0,0,
                127}));
        connect(heatCapacitorPCM.port, pCMThermalConductor2.port_b)
          annotation (Line(points={{0,16},{0,-30}}, color={191,0,0}));
        connect(heatCapacitorPCM.port, pCMThermalConductor1.port_b)
          annotation (Line(points={{0,16},{0,60}}, color={191,0,0}));
        connect(heatCapacitorPCM.liquidFraction, pCMThermalConductor1.liquidFraction)
          annotation (Line(points={{0,36.6},{38,36.6},{38,36},{44,36},{44,70.2},{10.6,
                70.2}}, color={0,0,127}));
        connect(heatCapacitorPCM.liquidFraction, pCMThermalConductor2.liquidFraction)
          annotation (Line(points={{0,36.6},{-16,36.6},{-16,36},{-36,36},{-36,-40.2},{
                -10.6,-40.2}}, color={0,0,127}));
        connect(pCMThermalConductor1.port_a, port_T)
          annotation (Line(points={{0,80},{0,102}}, color={191,0,0}));
        connect(pCMThermalConductor2.port_a, port_B)
          annotation (Line(points={{0,-50},{0,-100}}, color={191,0,0}));
        annotation (Icon(coordinateSystem(preserveAspectRatio=false), graphics={
                Rectangle(extent={{-80,80},{20,-80}}, lineColor={28,108,200}),
                Rectangle(extent={{20,80},{80,-80}}, lineColor={95,95,95})}),
                                                                       Diagram(
              coordinateSystem(preserveAspectRatio=false)));
      end disc1D_element_2DHT;

      model RHX_Element
        Modelica.Thermal.HeatTransfer.Components.HeatCapacitor heatCapacitor(C=
              C_RHX_element, T(start=T_start_RHX_element))
          annotation (Placement(transformation(extent={{-10,10},{10,30}})));
        Modelica.Thermal.HeatTransfer.Components.ThermalConductor thermalConductor(G=
              G_RHX_element)
          annotation (Placement(transformation(extent={{-60,-10},{-40,10}})));
        Modelica.Thermal.HeatTransfer.Components.ThermalConductor thermalConductor1(G
            =G_RHX_element)
          annotation (Placement(transformation(extent={{62,-10},{42,10}})));
        Modelica.Thermal.HeatTransfer.Interfaces.HeatPort_a port_pipe
          annotation (Placement(transformation(extent={{-110,-10},{-90,10}})));
        Modelica.Thermal.HeatTransfer.Interfaces.HeatPort_a port_water
          annotation (Placement(transformation(extent={{90,-10},{110,10}})));
        parameter Modelica.Units.SI.HeatCapacity C_RHX_element=1000
          "Heat capacity of element (= cp*m)";
        parameter Modelica.Units.SI.ThermalConductance G_RHX_element=100
          "Constant thermal conductance of material";
        parameter Modelica.Units.SI.Temperature T_start_RHX_element=293.15 "Temperature of element";
      equation
        connect(thermalConductor1.port_b, heatCapacitor.port)
          annotation (Line(points={{42,0},{0,0},{0,10}}, color={191,0,0}));
        connect(thermalConductor.port_b, heatCapacitor.port)
          annotation (Line(points={{-40,0},{0,0},{0,10}}, color={191,0,0}));
        connect(thermalConductor.port_a, port_pipe)
          annotation (Line(points={{-60,0},{-100,0}}, color={191,0,0}));
        connect(thermalConductor1.port_a, port_water)
          annotation (Line(points={{62,0},{100,0}}, color={191,0,0}));
        annotation (Icon(coordinateSystem(preserveAspectRatio=false), graphics={
                Rectangle(
                extent={{-20,40},{20,-40}},
                lineColor={135,135,135},
                pattern=LinePattern.Dash,
                fillColor={135,135,135},
                fillPattern=FillPattern.Solid)}), Diagram(coordinateSystem(
                preserveAspectRatio=false)));
      end RHX_Element;

      model Slab_element_1D
        parameter Modelica.Units.SI.Length L_cell "length of cell";
        parameter Modelica.Units.SI.Length W_cell "width of cell";
        parameter Modelica.Units.SI.Length d "thickness of cell";
        parameter Modelica.Units.SI.Temperature T_start=274.15 "Initial Temperature of PCM";
        parameter Integer N_w( min=1) "number of disc1D_element in the array";

        // External ports
        Modelica.Thermal.HeatTransfer.Interfaces.HeatPort_a port_P
          annotation (Placement(transformation(extent={{-110,-10},{-90,10}})));
        Modelica.Thermal.HeatTransfer.Interfaces.HeatPort_a port_R1
          annotation (Placement(transformation(extent={{90,-10},{110,10}})));

        // Outputs: averages over discs (single numbers)
        Modelica.Blocks.Interfaces.RealOutput LF_avg(min=0, max=1)
          "Average liquid fraction over all discs"
          annotation (Placement(transformation(extent={{96,38},{116,58}})));
        Modelica.Blocks.Interfaces.RealOutput T_avg(unit="K")
          "Average temperature over all discs"
          annotation (Placement(transformation(extent={{94,74},{114,94}})));

        // Components
        RHX_Element RHX_Element1(
          C_RHX_element=C_RHX_element,
          G_RHX_element=G_RHX_element,
          T_start_RHX_element=T_start_RHX_element)
          annotation (Placement(transformation(extent={{-80,-10},{-60,10}})));

        // Array of discs
        disc1D_element disc[N_w](
          each L_cell = L_cell,
          each W_cell = W_cell,
          each d      = d,
          each T_start = T_start)
          annotation (Placement(transformation(extent={{-36,-10},{-16,10}})));

        // Sum and average blocks for LF and T
        Modelica.Blocks.Math.Sum sumLF(nin=N_w)  "Sum of LF_Cell over discs";
        Modelica.Blocks.Math.Sum sumT(nin=N_w)   "Sum of T_Cell over discs";
        Modelica.Blocks.Math.Gain scaleLF(k=1.0/N_w);
        Modelica.Blocks.Math.Gain scaleT(k=1.0/N_w);

        parameter Modelica.Units.SI.HeatCapacity C_RHX_element=1000
          "Heat capacity of element (= cp*m)";
        parameter Modelica.Units.SI.ThermalConductance G_RHX_element=100
          "Constant thermal conductance of material";
        parameter Modelica.Units.SI.Temperature T_start_RHX_element=293.15
          "Temperature of element";
      equation
        // External left port and first disc both meet at RHX port_pipe
        connect(RHX_Element1.port_water, disc[1].port_L);
        connect(port_P, RHX_Element1.port_pipe)
          annotation (Line(points={{-100,0},{-80,0}}, color={191,0,0}));
        // Chain discs: port_R(i) -> port_L(i+1)
        for i in 1:N_w-1 loop
          connect(disc[i].port_R, disc[i+1].port_L);
        end for;
        // Right boundary
        connect(disc[N_w].port_R, port_R1);
        // Wire disc outputs into the summation blocks
        for i in 1:N_w loop
          connect(disc[i].LF_Cell, sumLF.u[i]);
          connect(disc[i].T_Cell,  sumT.u[i]);
        end for;
        // Averages = sums * (1/N_w)
        connect(sumLF.y, scaleLF.u);
        connect(scaleLF.y, LF_avg);

        connect(sumT.y, scaleT.u);
        connect(scaleT.y, T_avg);

        annotation (Icon(coordinateSystem(preserveAspectRatio=false), graphics={
              Rectangle(
                extent={{-80,-40},{-60,40}},
                lineColor={135,135,135},
                fillColor={135,135,135},
                fillPattern=FillPattern.Solid),
              Rectangle(
                extent={{-60,-40},{80,40}},
                lineColor={28,108,200},
                fillColor={28,108,200},
                fillPattern=FillPattern.Solid),
              Line(
                points={{-40,54},{-40,-54}},
                color={0,0,0},
                thickness=1,
                pattern=LinePattern.Dash),
              Line(
                points={{-20,54},{-20,-54}},
                color={0,0,0},
                thickness=1,
                pattern=LinePattern.Dash),
              Line(
                points={{0,54},{0,-54}},
                color={0,0,0},
                thickness=1,
                pattern=LinePattern.Dash),
              Line(
                points={{20,54},{20,-54}},
                color={0,0,0},
                thickness=1,
                pattern=LinePattern.Dash),
              Line(
                points={{40,54},{40,-54}},
                color={0,0,0},
                thickness=1,
                pattern=LinePattern.Dash),
              Line(
                points={{60,56},{60,-52}},
                color={0,0,0},
                thickness=1,
                pattern=LinePattern.Dash)}), Diagram(coordinateSystem(
                preserveAspectRatio=false)));
      end Slab_element_1D;

      model Slab
        replaceable package Medium_RHX =
            Modelica.Media.Interfaces.PartialMedium
        "Roll-bond HX fluid medium";

        // Geometry and discretization
        parameter Modelica.Units.SI.Length L_RHX=1.3 "length of roll-bond heat exchanger";
        parameter Modelica.Units.SI.Length W_RHX=0.563 "length of roll-bond heat exchanger";
        parameter Modelica.Units.SI.Length Th_RHX=0.0155 "Thickness of PCM in the slab";
        parameter Integer N_p( min=1) "number of descritization in pipe";
        parameter Integer N_w( min=1) "number of disc1D_element in the array";

        // Derived cell sizes
        parameter Modelica.Units.SI.Length L_cell=L_RHX/N_p "length of cell";
        parameter Modelica.Units.SI.Length W_cell=W_RHX "width of cell";
        parameter Modelica.Units.SI.Length d=Th_RHX/N_w "thickness of cell";

        // Initial temperature of the PCM
        parameter Modelica.Units.SI.Temperature T_start=274.15
          "Initial Temperature of PCM";

        // Thermal params for the RHX-side element attached to each slab element
        parameter Modelica.Units.SI.HeatCapacity C_RHX_element=1000
          "Heat capacity of element (= cp*m)";
        parameter Modelica.Units.SI.ThermalConductance G_RHX_element=100
          "Constant thermal conductance of material";
        parameter Modelica.Units.SI.Temperature T_start_RHX_element=293.15
          "Temperature of element";

        // Pipe sizing
        parameter Modelica.Units.SI.Length RHX_Equi_diameter=0.01
          "RHX equivalent diameter";
        parameter Modelica.Units.SI.Length RHX_Equi_length=1.3 "Length of the pipe";

        // === Array of slab elements (size = N_p) ===
        Slab_element_1D Slabele[N_p](
          each L_cell=L_cell,
          each W_cell=W_cell,
          each d=d,
          each T_start=T_start,
          each N_w=N_w,
          each C_RHX_element=C_RHX_element,
          each G_RHX_element=G_RHX_element,
          each T_start_RHX_element=T_start_RHX_element)
          annotation (Placement(transformation(extent={{-36,-10},{-16,10}})));

        // External heat port (all ele[i].port_R1 connect here)
        Modelica.Thermal.HeatTransfer.Interfaces.HeatPort_a port_W
          annotation (Placement(transformation(extent={{90,-10},{110,10}})));

        // Pipe with multiple heat ports (one per segment)
        AGRI_COOL.Buildings.Fluid.FixedResistances.Pipe RHX_Pipe(
          redeclare package Medium = Medium_RHX,
          T_start=268.15,
          m_flow_nominal=0.5,
          nSeg=N_p,
          thicknessIns=0.0000000000001,
          lambdaIns=1,
          diameter=RHX_Equi_diameter,
          length=RHX_Equi_length,
          useMultipleHeatPorts=true) annotation (Placement(transformation(
              extent={{-10,10},{10,-10}},
              rotation=270,
              origin={-88,0})));

        // Fluid ports
        Modelica.Fluid.Interfaces.FluidPort_a port_a1(redeclare package Medium =
              Medium_RHX)
          "Fluid connector a (positive design flow direction is from port_a to port_b)"
          annotation (Placement(transformation(extent={{-98,90},{-78,110}})));
        Modelica.Fluid.Interfaces.FluidPort_b port_b1(redeclare package Medium =
              Medium_RHX)
          "Fluid connector b (positive design flow direction is from port_a to port_b)"
          annotation (Placement(transformation(extent={{-98,-110},{-78,-90}})));

        // overall averages for the whole slab ===
        Modelica.Blocks.Interfaces.RealOutput LF_Slab(min=0, max=1)
          "Average liquid fraction of the entire slab"
          annotation (Placement(transformation(extent={{96,44},{116,64}})));
        Modelica.Blocks.Interfaces.RealOutput T_Slab(unit="K")
          "Average temperature of the entire slab"
          annotation (Placement(transformation(extent={{96,70},{116,90}})));

        Modelica.Blocks.Math.Sum  sumLFslab(nin=N_p)  "Sum of LF_avg over elements";
        Modelica.Blocks.Math.Sum  sumTslab(nin=N_p)   "Sum of T_avg over elements";
        Modelica.Blocks.Math.Gain scaleLFslab(k=1.0/N_p);
        Modelica.Blocks.Math.Gain scaleTslab(k=1.0/N_p);

      equation
        // Pipe hydraulics to outside
        connect(RHX_Pipe.port_a, port_a1)
          annotation (Line(points={{-88,10},{-88,100}}, color={0,127,255}));
        connect(RHX_Pipe.port_b, port_b1)
          annotation (Line(points={{-88,-10},{-88,-100}}, color={0,127,255}));
        // Thermal couplings:
        // 1) Each slab element i to the i-th pipe heat port
        for i in 1:N_p loop
          connect(Slabele[i].port_P, RHX_Pipe.heatPorts[i]);
        end for;
        // 2) All slab elements' port_R1 to the common wall port_W
        for i in 1:N_p loop
          connect(Slabele[i].port_R1, port_W);
        end for;
        // wire element averages into slab-level averages
        for i in 1:N_p loop
          connect(Slabele[i].LF_avg, sumLFslab.u[i]);
          connect(Slabele[i].T_avg,  sumTslab.u[i]);
        end for;
        // Averages = sums * (1/N_w)
        connect(sumLFslab.y, scaleLFslab.u);
        connect(scaleLFslab.y, LF_Slab);

        connect(sumTslab.y, scaleTslab.u);
        connect(scaleTslab.y, T_Slab);

        annotation (Icon(coordinateSystem(preserveAspectRatio=false), graphics={
              Rectangle(
                extent={{-80,-84},{-70,76}},
                lineColor={135,135,135},
                fillColor={28,108,200},
                fillPattern=FillPattern.Solid),
              Rectangle(
                extent={{-70,-84},{-60,76}},
                lineColor={135,135,135},
                fillColor={135,135,135},
                fillPattern=FillPattern.Solid),
              Rectangle(
                extent={{-60,-84},{80,76}},
                lineColor={28,108,200},
                fillColor={85,170,255},
                fillPattern=FillPattern.Solid),
              Line(
                points={{-40,90},{-40,-96}},
                color={0,0,0},
                thickness=1,
                pattern=LinePattern.Dash),
              Line(
                points={{-20,90},{-20,-96}},
                color={0,0,0},
                thickness=1,
                pattern=LinePattern.Dash),
              Line(
                points={{0,90},{0,-94}},
                color={0,0,0},
                thickness=1,
                pattern=LinePattern.Dash),
              Line(
                points={{20,90},{20,-94}},
                color={0,0,0},
                thickness=1,
                pattern=LinePattern.Dash),
              Line(
                points={{40,90},{40,-94}},
                color={0,0,0},
                thickness=1,
                pattern=LinePattern.Dash),
              Line(
                points={{60,92},{62,-92}},
                color={0,0,0},
                thickness=1,
                pattern=LinePattern.Dash),
              Line(
                points={{-96,36},{96,36}},
                color={0,0,0},
                thickness=1,
                pattern=LinePattern.Dash),
              Line(
                points={{-94,-4},{98,-4}},
                color={0,0,0},
                thickness=1,
                pattern=LinePattern.Dash),
              Line(
                points={{-94,-44},{98,-44}},
                color={0,0,0},
                thickness=1,
                pattern=LinePattern.Dash),
              Ellipse(
                extent={{-70,-86},{-80,-80}},
                lineColor={135,135,135},
                fillColor={0,0,0},
                fillPattern=FillPattern.Solid),
              Ellipse(
                extent={{-70,72},{-80,78}},
                lineColor={135,135,135},
                fillColor={0,0,0},
                fillPattern=FillPattern.Solid)}), Diagram(coordinateSystem(
                preserveAspectRatio=false)));
      end Slab;

      model Test_Slab
      extends Modelica.Icons.Example;
      extends Components.Base_Classes.Medium_Definition;
        Slab slab(
          redeclare package Medium_RHX = Medium_HTF,
          N_p=10,
          N_w=50,
          T_start_RHX_element=274.15)
          annotation (Placement(transformation(extent={{-40,-10},{-20,10}})));
        Buildings.Fluid.Sources.MassFlowSource_T boundary(
          redeclare package Medium = Medium_HTF,
          m_flow=0.358/8,
          T=268.15,
          nPorts=1) annotation (Placement(transformation(
              extent={{-10,-10},{10,10}},
              rotation=270,
              origin={-38,82})));
        Buildings.Fluid.Sources.Boundary_pT boundary1(redeclare package
                    Medium = Medium_HTF, nPorts=1) annotation (Placement(
              transformation(
              extent={{-10,-10},{10,10}},
              rotation=90,
              origin={-38,-82})));
        Buildings.Fluid.Sensors.TemperatureTwoPort senTem(
          redeclare package Medium = Medium_HTF,
          m_flow_nominal=0.5,
          T_start=268.15) annotation (Placement(transformation(
              extent={{-10,-10},{10,10}},
              rotation=270,
              origin={-38,42})));
        Buildings.Fluid.Sensors.TemperatureTwoPort senTem1(
          redeclare package Medium = Medium_HTF,
          m_flow_nominal=0.5,
          T_start=268.15) annotation (Placement(transformation(
              extent={{-10,-10},{10,10}},
              rotation=270,
              origin={-38,-40})));
      equation
        connect(boundary.ports[1], senTem.port_a)
          annotation (Line(points={{-38,72},{-38,52}}, color={0,127,255}));
        connect(slab.port_a1, senTem.port_b) annotation (Line(points={{-38.8,
                10},{-38,10},{-38,32}}, color={0,127,255}));
        connect(slab.port_b1, senTem1.port_a) annotation (Line(points={{-38.8,
                -10},{-38,-12},{-38,-30}}, color={0,127,255}));
        connect(boundary1.ports[1], senTem1.port_b)
          annotation (Line(points={{-38,-72},{-38,-50}}, color={0,127,255}));
        annotation (Icon(coordinateSystem(preserveAspectRatio=false)), Diagram(
              coordinateSystem(preserveAspectRatio=false)),
          experiment(StopTime=18000, __Dymola_Algorithm="Dassl"));
      end Test_Slab;

      model Test_Slab_2RHX
      extends Modelica.Icons.Example;
      extends Components.Base_Classes.Medium_Definition;
        Slab slab1_NC(
          redeclare package Medium_RHX = Medium_HTF,
          N_p=10,
          N_w=50,
          T_start_RHX_element=274.15)
          annotation (Placement(transformation(extent={{-76,-12},{-56,8}})));
        AGRI_COOL.Buildings.Fluid.Sources.MassFlowSource_T boundary(
          redeclare package Medium = Medium_HTF,
          m_flow=0.358/8,
          T=268.15,
          nPorts=1) annotation (Placement(transformation(
              extent={{-10,-10},{10,10}},
              rotation=270,
              origin={-74,80})));
        AGRI_COOL.Buildings.Fluid.Sources.Boundary_pT boundary1(redeclare
            package Medium = Medium_HTF, nPorts=1) annotation (Placement(
              transformation(
              extent={{-10,-10},{10,10}},
              rotation=180,
              origin={48,-72})));
        AGRI_COOL.Buildings.Fluid.Sensors.TemperatureTwoPort Tin_NC(
          redeclare package Medium = Medium_HTF,
          m_flow_nominal=0.5,
          T_start=268.15) annotation (Placement(transformation(
              extent={{-10,-10},{10,10}},
              rotation=270,
              origin={-74,40})));
        AGRI_COOL.Buildings.Fluid.Sensors.TemperatureTwoPort Tout_NC(
          redeclare package Medium = Medium_HTF,
          m_flow_nominal=0.5,
          T_start=268.15) annotation (Placement(transformation(
              extent={{-10,-10},{10,10}},
              rotation=0,
              origin={-20,-72})));
        Slab slab2_NC(
          redeclare package Medium_RHX = Medium_HTF,
          N_p=10,
          N_w=50,
          T_start_RHX_element=274.15) annotation (Placement(transformation(
                extent={{-76,-44},{-56,-24}})));
        Slab slab1_C(
          redeclare package Medium_RHX = Medium_HTF,
          N_p=10,
          N_w=50,
          T_start_RHX_element=274.15)
          annotation (Placement(transformation(extent={{66,50},{86,70}})));
        AGRI_COOL.Buildings.Fluid.Sources.MassFlowSource_T boundary2(
          redeclare package Medium = Medium_HTF,
          m_flow=0.358/8,
          T=268.15,
          nPorts=1) annotation (Placement(transformation(
              extent={{-10,-10},{10,10}},
              rotation=0,
              origin={-8,82})));
        AGRI_COOL.Buildings.Fluid.Sources.Boundary_pT boundary3(redeclare
            package Medium = Medium_HTF, nPorts=1) annotation (Placement(
              transformation(
              extent={{-10,-10},{10,10}},
              rotation=90,
              origin={70,-44})));
        AGRI_COOL.Buildings.Fluid.Sensors.TemperatureTwoPort Tin_C(
          redeclare package Medium = Medium_HTF,
          m_flow_nominal=0.5,
          T_start=268.15) annotation (Placement(transformation(
              extent={{-10,-10},{10,10}},
              rotation=0,
              origin={44,82})));
        AGRI_COOL.Buildings.Fluid.Sensors.TemperatureTwoPort Tout_C(
          redeclare package Medium = Medium_HTF,
          m_flow_nominal=0.5,
          T_start=268.15) annotation (Placement(transformation(
              extent={{-10,-10},{10,10}},
              rotation=270,
              origin={68,-6})));
        Slab slab2_C(
          redeclare package Medium_RHX = Medium_HTF,
          N_p=10,
          N_w=50,
          T_start_RHX_element=274.15)
          annotation (Placement(transformation(extent={{66,18},{86,38}})));
      equation
        connect(boundary.ports[1], Tin_NC.port_a)
          annotation (Line(points={{-74,70},{-74,50}}, color={0,127,255}));
        connect(slab1_NC.port_a1, Tin_NC.port_b) annotation (Line(points={{
                -74.8,8},{-74,8},{-74,30}}, color={0,127,255}));
        connect(boundary1.ports[1], Tout_NC.port_b)
          annotation (Line(points={{38,-72},{-10,-72}}, color={0,127,255}));
        connect(slab1_NC.port_b1, slab2_NC.port_a1) annotation (Line(points={
                {-74.8,-12},{-74.8,-24}}, color={0,127,255}));
        connect(slab2_NC.port_b1, Tout_NC.port_a) annotation (Line(points={{
                -74.8,-44},{-74,-44},{-74,-72},{-30,-72}}, color={0,127,255}));
        connect(boundary2.ports[1], Tin_C.port_a)
          annotation (Line(points={{2,82},{34,82}}, color={0,127,255}));
        connect(boundary3.ports[1], Tout_C.port_b) annotation (Line(points={{
                70,-34},{70,-20},{68,-20},{68,-16}}, color={0,127,255}));
        connect(slab1_C.port_b1, slab2_C.port_a1)
          annotation (Line(points={{67.2,50},{67.2,38}}, color={0,127,255}));
        connect(slab2_C.port_b1, Tout_C.port_a) annotation (Line(points={{
                67.2,18},{68,18},{68,4}}, color={0,127,255}));
        connect(Tin_C.port_b, slab1_C.port_a1) annotation (Line(points={{54,
                82},{67.2,82},{67.2,70}}, color={0,127,255}));
        connect(slab1_C.port_W, slab2_C.port_W) annotation (Line(points={{86,
                60},{98,60},{98,28},{86,28}}, color={191,0,0}));
        annotation (Icon(coordinateSystem(preserveAspectRatio=false)), Diagram(
              coordinateSystem(preserveAspectRatio=false)),
          experiment(StopTime=18000, __Dymola_Algorithm="Dassl"));
      end Test_Slab_2RHX;

      model Double_Slab
        replaceable package Medium_RHX =
            Modelica.Media.Interfaces.PartialMedium
        "Roll-bond HX fluid medium";

        // Geometry and discretization
        parameter Modelica.Units.SI.Length L_RHX=1.3 "length of roll-bond heat exchanger";
        parameter Modelica.Units.SI.Length W_RHX=0.563 "length of roll-bond heat exchanger";
        parameter Modelica.Units.SI.Length Th_RHX=0.0155 "Thickness of PCM in the slab";
        parameter Integer N_p( min=1) "number of descritization in pipe";
        parameter Integer N_w( min=1) "number of disc1D_element in the array";

        // Derived cell sizes
        parameter Modelica.Units.SI.Length L_cell=L_RHX/N_p "length of cell";
        parameter Modelica.Units.SI.Length W_cell=W_RHX "width of cell";
        parameter Modelica.Units.SI.Length d=Th_RHX/N_w "thickness of cell";

        // Initial temperature of the PCM
        parameter Modelica.Units.SI.Temperature T_start=274.15
          "Initial Temperature of PCM";

        // Thermal params for the RHX-side element attached to each slab element
        parameter Modelica.Units.SI.HeatCapacity C_RHX_element=1000
          "Heat capacity of element (= cp*m)";
        parameter Modelica.Units.SI.ThermalConductance G_RHX_element=100
          "Constant thermal conductance of material";
        parameter Modelica.Units.SI.Temperature T_start_RHX_element=293.15
          "Temperature of element";

        // Pipe sizing
        parameter Modelica.Units.SI.Length RHX_Equi_diameter=0.01
          "RHX equivalent diameter";
        parameter Modelica.Units.SI.Length RHX_Equi_length=1.3 "Length of the pipe";

        // === Array of slab elements (size = N_p) ===
        Slab_element_1D Slabele_R[N_p](
          each L_cell=L_cell,
          each W_cell=W_cell,
          each d=d,
          each T_start=T_start,
          each N_w=N_w,
          each C_RHX_element=C_RHX_element,
          each G_RHX_element=G_RHX_element,
          each T_start_RHX_element=T_start_RHX_element)
          annotation (Placement(transformation(extent={{40,-10},{60,10}})));

        Slab_element_1D Slabele_L[N_p](
          each L_cell=L_cell,
          each W_cell=W_cell,
          each d=d,
          each T_start=T_start,
          each N_w=N_w,
          each C_RHX_element=C_RHX_element,
          each G_RHX_element=G_RHX_element,
          each T_start_RHX_element=T_start_RHX_element)
          annotation (Placement(transformation(extent={{-40,-10},{-60,10}})));

        // External heat port (all ele[i].port_R1 connect here)
        Modelica.Thermal.HeatTransfer.Interfaces.HeatPort_a port_WR
          annotation (Placement(transformation(extent={{90,-10},{110,10}})));
        Modelica.Thermal.HeatTransfer.Interfaces.HeatPort_a port_WL
          annotation (Placement(transformation(extent={{-110,-10},{-90,10}})));

        // Pipe with multiple heat ports (one per segment)
        AGRI_COOL.Buildings.Fluid.FixedResistances.Pipe RHX_Pipe(
          redeclare package Medium = Medium_RHX,
          T_start=T_start_PF,
          m_flow_nominal=0.5,
          nSeg=N_p,
          thicknessIns=0.0000000000001,
          lambdaIns=1,
          diameter=RHX_Equi_diameter,
          length=RHX_Equi_length,
          useMultipleHeatPorts=true) annotation (Placement(transformation(
              extent={{-10,10},{10,-10}},
              rotation=270,
              origin={-6,0})));

        // Fluid ports
        Modelica.Fluid.Interfaces.FluidPort_a port_a1(redeclare package Medium =
              Medium_RHX)
          "Fluid connector a (positive design flow direction is from port_a to port_b)"
          annotation (Placement(transformation(extent={{-16,90},{4,110}})));
        Modelica.Fluid.Interfaces.FluidPort_b port_b1(redeclare package Medium =
              Medium_RHX)
          "Fluid connector b (positive design flow direction is from port_a to port_b)"
          annotation (Placement(transformation(extent={{-16,-110},{4,-90}})));

        // overall averages for the whole slab ===
        Modelica.Blocks.Interfaces.RealOutput LF_Slab(min=0, max=1)
          "Average liquid fraction of the entire slab"
          annotation (Placement(transformation(extent={{96,44},{116,64}})));
        Modelica.Blocks.Interfaces.RealOutput T_Slab(unit="K")
          "Average temperature of the entire slab"
          annotation (Placement(transformation(extent={{96,70},{116,90}})));

        Modelica.Blocks.Math.Sum  sumLFslab(nin=2*N_p)  "Sum of LF_avg over elements";
        Modelica.Blocks.Math.Sum  sumTslab(nin=2*N_p)   "Sum of T_avg over elements";
        Modelica.Blocks.Math.Gain scaleLFslab(k=1.0/(2*N_p));
        Modelica.Blocks.Math.Gain scaleTslab(k=1.0/(2*N_p));

        parameter Modelica.Media.Interfaces.Types.Temperature T_start_PF=268.15
          "Start value of temperature for the fluid inside the pipe";
      equation
        // Pipe hydraulics to outside
        connect(RHX_Pipe.port_a, port_a1)
          annotation (Line(points={{-6,10},{-6,100}},   color={0,127,255}));
        connect(RHX_Pipe.port_b, port_b1)
          annotation (Line(points={{-6,-10},{-6,-100}},   color={0,127,255}));
        // Thermal couplings:
        // 1) Each slab element i to the i-th pipe heat port
        for i in 1:N_p loop
          connect(Slabele_R[i].port_P, RHX_Pipe.heatPorts[i]);
        end for;
        // 2) All slab elements' port_R1 to the common wall port_W
        for i in 1:N_p loop
          connect(Slabele_R[i].port_R1, port_WR);
        end for;
        // 1) Each slab element i to the i-th pipe heat port
        for i in 1:N_p loop
          connect(Slabele_L[i].port_P, RHX_Pipe.heatPorts[i]);
        end for;
        // 2) All slab elements' port_R1 to the common wall port_W
        for i in 1:N_p loop
          connect(Slabele_L[i].port_R1, port_WL);
        end for;
        // wire element averages into slab-level averages
        for i in 1:N_p loop
          connect(Slabele_R[i].LF_avg, sumLFslab.u[i]);
          connect(Slabele_R[i].T_avg,  sumTslab.u[i]);
        end for;

        for i in 1:N_p loop
          connect(Slabele_L[i].LF_avg, sumLFslab.u[i+N_p]);
          connect(Slabele_L[i].T_avg,  sumTslab.u[i+N_p]);
        end for;
        // Averages = sums * (1/N_w)
        connect(sumLFslab.y, scaleLFslab.u);
        connect(scaleLFslab.y, LF_Slab);

        connect(sumTslab.y, scaleTslab.u);
        connect(scaleTslab.y, T_Slab);

        annotation (Icon(coordinateSystem(preserveAspectRatio=false), graphics={
              Rectangle(
                extent={{-80,-84},{80,76}},
                lineColor={28,108,200},
                fillColor={85,170,255},
                fillPattern=FillPattern.Solid),
              Line(
                points={{-40,90},{-40,-96}},
                color={0,0,0},
                thickness=1,
                pattern=LinePattern.Dash),
              Line(
                points={{-20,90},{-20,-96}},
                color={0,0,0},
                thickness=1,
                pattern=LinePattern.Dash),
              Line(
                points={{0,90},{0,-94}},
                color={0,0,0},
                thickness=1,
                pattern=LinePattern.Dash),
              Line(
                points={{20,90},{20,-94}},
                color={0,0,0},
                thickness=1,
                pattern=LinePattern.Dash),
              Line(
                points={{40,90},{40,-94}},
                color={0,0,0},
                thickness=1,
                pattern=LinePattern.Dash),
              Line(
                points={{60,92},{62,-92}},
                color={0,0,0},
                thickness=1,
                pattern=LinePattern.Dash),
              Line(
                points={{-96,36},{96,36}},
                color={0,0,0},
                thickness=1,
                pattern=LinePattern.Dash),
              Line(
                points={{-94,-4},{98,-4}},
                color={0,0,0},
                thickness=1,
                pattern=LinePattern.Dash),
              Line(
                points={{-94,-44},{98,-44}},
                color={0,0,0},
                thickness=1,
                pattern=LinePattern.Dash),
              Rectangle(
                extent={{6,-84},{16,76}},
                lineColor={135,135,135},
                fillColor={135,135,135},
                fillPattern=FillPattern.Solid),
              Rectangle(
                extent={{-4,-84},{6,76}},
                lineColor={135,135,135},
                fillColor={28,108,200},
                fillPattern=FillPattern.Solid),
              Ellipse(
                extent={{6,-86},{-4,-80}},
                lineColor={135,135,135},
                fillColor={0,0,0},
                fillPattern=FillPattern.Solid),
              Ellipse(
                extent={{6,72},{-4,78}},
                lineColor={135,135,135},
                fillColor={0,0,0},
                fillPattern=FillPattern.Solid),
              Line(
                points={{-58,90},{-58,-96}},
                color={0,0,0},
                thickness=1,
                pattern=LinePattern.Dash)}),      Diagram(coordinateSystem(
                preserveAspectRatio=false)));
      end Double_Slab;


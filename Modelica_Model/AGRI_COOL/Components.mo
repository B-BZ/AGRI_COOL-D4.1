            Modelica.Blocks.Logical.LessEqualThreshold lessEqualThreshold(threshold=
                  T_Threshold)
              annotation (Placement(transformation(extent={{-28,48},{-8,68}})));
            Modelica.Blocks.Math.Add TempDiff(k2=-1)
              annotation (Placement(transformation(extent={{-72,48},{-52,68}})));
            Modelica.Blocks.Logical.Switch switch1
              annotation (Placement(transformation(extent={{24,-52},{44,-32}})));
            Modelica.Blocks.Sources.Constant ZeroFlow(k=0) annotation (Placement(
                  transformation(
                  extent={{-10,-10},{10,10}},
                  rotation=270,
                  origin={38,20})));

            Modelica.Blocks.Logical.GreaterThreshold hasMass(threshold=0.001)
              annotation (Placement(transformation(extent={{-72,-52},{-52,-32}})));
            Modelica.Blocks.Logical.Timer timer
              annotation (Placement(transformation(extent={{-22,4},{-2,24}})));
            Modelica.Blocks.Logical.And transferCondition
              annotation (Placement(transformation(extent={{-28,-32},{-8,-12}})));
          // Discrete variable for storing initial mass at the start of transfer
            discrete Real m_start;
            Real a;
            Modelica.Blocks.Math.Product product1
              annotation (Placement(transformation(extent={{-6,-80},{14,-60}})));
            Modelica.Blocks.Sources.RealExpression realExpression(y=a)
              annotation (Placement(transformation(extent={{-90,-102},{-70,-82}})));
            Modelica.Blocks.Logical.GreaterThreshold greaterThreshold
              annotation (Placement(transformation(extent={{34,52},{54,72}})));
            Modelica.Blocks.Interfaces.RealInput m_out annotation (Placement(
                  transformation(
                  extent={{-20,-20},{20,20}},
                  rotation=270,
                  origin={16,110})));
            Modelica.Blocks.Logical.Switch switch2
              annotation (Placement(transformation(extent={{72,12},{92,32}})));
            Modelica.Blocks.Interfaces.BooleanOutput Tank_Emptying_Signal
              "Connector of Boolean output signal"
              annotation (Placement(transformation(extent={{96,52},{116,72}})));
          equation
            // Capture initial mass when transfer starts
            when lessEqualThreshold.y then
              m_start =pre(m1);
            end when;
            // Compute flow rate coefficient
            a = 2 * m_start / (Transfer_Time^2);

            connect(T1, TempDiff.u1) annotation (Line(points={{-106,60},{-82,60},
                    {-82,64},{-74,64}},
                               color={0,0,127}));
            connect(T2, TempDiff.u2) annotation (Line(points={{-106,18},{-82,18},
                    {-82,52},{-74,52}},
                               color={0,0,127}));
            connect(TempDiff.y, lessEqualThreshold.u)
              annotation (Line(points={{-51,58},{-30,58}},color={0,0,127}));
            connect(ZeroFlow.y, switch1.u3) annotation (Line(points={{38,9},{38,
                    -24},{14,-24},{14,-50},{22,-50}}, color={0,0,127}));
            connect(m1, hasMass.u) annotation (Line(points={{-108,-60},{-84,-60},
                    {-84,-42},{-74,-42}}, color={0,0,127}));
            connect(lessEqualThreshold.y, transferCondition.u1) annotation (Line(points={{-7,58},
                    {4,58},{4,-10},{-42,-10},{-42,-22},{-30,-22}},         color={255,0,255}));
            connect(hasMass.y, transferCondition.u2) annotation (Line(points={{-51,-42},
                    {-38,-42},{-38,-30},{-30,-30}},
                                              color={255,0,255}));
            connect(transferCondition.y, switch1.u2) annotation (Line(points={{-7,-22},
                    {4,-22},{4,-42},{22,-42}},
                                             color={255,0,255}));
            connect(timer.y, product1.u1) annotation (Line(points={{-1,14},{2,
                    14},{2,-48},{-8,-48},{-8,-64}},
                                        color={0,0,127}));
            connect(realExpression.y, product1.u2)
              annotation (Line(points={{-69,-92},{-16,-92},{-16,-76},{-8,-76}},
                                                                    color={0,0,127}));
            connect(lessEqualThreshold.y, timer.u) annotation (Line(points={{-7,58},
                    {0,58},{0,26},{-34,26},{-34,14},{-24,14}},
                                                   color={255,0,255}));
            connect(product1.y, switch1.u1) annotation (Line(points={{15,-70},{
                    16,-70},{16,-34},{22,-34}},
                                             color={0,0,127}));
            connect(greaterThreshold.u, m_out) annotation (Line(points={{32,62},

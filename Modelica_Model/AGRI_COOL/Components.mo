          model Controller1
            parameter Real T_Threshold = 1 "Temperature difference threshold for activation";
            parameter Real Transfer_Time=10 "the time in which all the mass from tank 1 transfers to tank 2";
            Modelica.Blocks.Interfaces.RealInput T1

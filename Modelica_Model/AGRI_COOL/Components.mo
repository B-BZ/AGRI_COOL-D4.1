within AGRI_COOL;
package Components
  "This package contains the models for different components imployed in AGRI_COOL system setups."
  package Base_Classes
    partial model Medium_Definition
      constant Modelica.Units.SI.Temperature HTF_T=273.15;
      constant Real X_glycol(min=0, max=1) =0.4;
      replaceable package Medium_Air = AGRI_COOL.Buildings.Media.Air;
      replaceable package Medium_HTF =
          AGRI_COOL.Buildings.Media.Antifreeze.EthyleneGlycolWater (                            property_T = HTF_T,X_a=X_glycol);
      annotation (
        Icon(coordinateSystem(preserveAspectRatio=false)),
        Diagram(coordinateSystem(preserveAspectRatio=false)),
        Documentation(
          info = "This partial model defines the fluid media for AGRI_COOL fluid-based models."));
    end Medium_Definition;
    annotation (Documentation(info="<html>
<p><span style=\"font-size: 14pt;\">This package contains classes that are repeatedly used in different models. </span></p>
</html>"));
  end Base_Classes;

  package Cold_Room "This package contains the model for cold room structure."

    model ColdROOM_V01
      "This model contains the structure of cold room and relevant connectors to other models."
      replaceable package Medium_CR = Modelica.Media.Interfaces.PartialMedium
      "Air medium in the cold room";

      //cold room dimentions
      parameter Real VFlo(unit="m3") = 4.6*11*4 "Room Volume";
      parameter Real AFlo(unit="m2") = 4.6*11 "Floor area";
      parameter Real hRoo(unit="m")  = 4 "Room height";

      parameter Integer nPortsAir(min=2) = 5
        "Number of air inlets/outlets" annotation(Evaluate=true);

      AGRI_COOL.Buildings.ThermalZones.Detailed.MixedAir CR_Zone(
        redeclare package Medium = Medium_CR,
        AFlo=AFlo,
        hRoo=hRoo,
        nConExt=4,
        datConExt(
          layers={conExtWal,conExtWal,conExtWal,conExtWal},
          A={4.6,11,4.6,11}*hRoo,
          til={AGRI_COOL.Buildings.Types.Tilt.Wall,AGRI_COOL.Buildings.Types.Tilt.Wall,
              AGRI_COOL.Buildings.Types.Tilt.Wall,AGRI_COOL.Buildings.Types.Tilt.Wall},
          azi={AGRI_COOL.Buildings.Types.Azimuth.N,AGRI_COOL.Buildings.Types.Azimuth.E,
              AGRI_COOL.Buildings.Types.Azimuth.S,AGRI_COOL.Buildings.Types.Azimuth.W}),
        nConExtWin=0,
        nConPar=0,
        nConBou=2,
        datConBou(
          layers={conFlo,conFlo},
          A={AFlo,AFlo},
          til={AGRI_COOL.Buildings.Types.Tilt.Floor,AGRI_COOL.Buildings.Types.Tilt.Floor}),
        nSurBou=0,
        nPorts=nPortsAir,
        energyDynamics=Modelica.Fluid.Types.Dynamics.FixedInitial) "cold room zone"
        annotation (Placement(transformation(extent={{-18,10},{22,50}})));

      // Thermal envelop data records
      parameter AGRI_COOL.Buildings.HeatTransfer.Data.Solids.Generic matPlySty(
        x(displayUnit="mm") = 0.2,
        k=0.034,
        c=1300,
        d=25) "polystyrene for floor and ceiling"
        annotation (Placement(transformation(extent={{-56,-92},{-36,-72}})));
      parameter AGRI_COOL.Buildings.HeatTransfer.Data.Resistances.Carpet
                                                     matCar "Carpet"
        annotation (Placement(transformation(extent={{18,-64},{38,-44}})));
      parameter AGRI_COOL.Buildings.HeatTransfer.Data.OpaqueConstructions.Generic
                                                              conExtWal(final nLay=1,
          material={matPlyUre})            "Exterior construction"
        annotation (Placement(transformation(extent={{-22,-64},{-2,-44}})));
      parameter AGRI_COOL.Buildings.HeatTransfer.Data.OpaqueConstructions.Generic
                                                              conFlo(final nLay=1,
          material={matPlySty})
                     "Floor construction (opa_a is carpet)"
        annotation (Placement(transformation(extent={{-22,-92},{-2,-72}})));
      parameter AGRI_COOL.Buildings.HeatTransfer.Data.OpaqueConstructions.Generic conFur(final
          nLay=1, material={matPlySty})
        "Construction for internal mass of furniture"
        annotation (Placement(transformation(extent={{44,-64},{64,-44}})));
      parameter AGRI_COOL.Buildings.HeatTransfer.Data.Solids.Generic matPlyUre(
        k=0.025,
        c=1300,
        d=40,
        x(displayUnit="mm") = 0.2) "polyurethane for walls"
        annotation (Placement(transformation(extent={{-54,-64},{-34,-44}})));
      AGRI_COOL.Buildings.BoundaryConditions.WeatherData.Bus weaBus1
                                                "Weather data"
        annotation (Placement(transformation(extent={{44,90},{64,110}})));
      AGRI_COOL.Buildings.HeatTransfer.Sources.PrescribedTemperature
                                                      preTem "object for outdoor temperature"
        annotation (Placement(transformation(extent={{-72,-12},{-52,8}})));
      AGRI_COOL.Buildings.HeatTransfer.Windows.BaseClasses.ThermalConductor thermalConductor(G=G)
        annotation (Placement(transformation(extent={{-12,-12},{10,10}})));
      Modelica.Blocks.Sources.Constant G_FC(k=1)
        annotation (Placement(transformation(extent={{-48,6},{-28,26}})));
      Modelica.Fluid.Vessels.BaseClasses.VesselFluidPorts_b ports_Air_CR[nPortsAir](
          redeclare package Medium = Medium_CR) "Fluid inlets and outlets"
        annotation (Placement(transformation(
            extent={{-27,-6},{27,6}},
            rotation=90,
            origin={-100,-63}), iconTransformation(
            extent={{-27,-6},{27,6}},
            rotation=90,
            origin={-100,-63})));
      Modelica.Thermal.HeatTransfer.Interfaces.HeatPort_a heaPorAir1
        "Heat port to air volume"
        annotation (Placement(transformation(extent={{90,6},{110,26}}),
            iconTransformation(extent={{90,6},{110,26}})));
      Modelica.Thermal.HeatTransfer.Interfaces.HeatPort_a heaPorRad1
        "Heat port for radiative heat gain and radiative temperature"
        annotation (Placement(transformation(extent={{90,-78},{110,-58}}),
            iconTransformation(extent={{90,-78},{110,-58}})));
      Modelica.Thermal.HeatTransfer.Sensors.TemperatureSensor T_CR
        "Cold room air temperature sensor"
        annotation (Placement(transformation(extent={{62,42},{82,62}})));
      Modelica.Blocks.Interfaces.RealOutput T_in_CR
        "Absolute temperature as output signal"
        annotation (Placement(transformation(extent={{98,62},{118,82}})));
      Modelica.Blocks.Math.MatrixGain gai(K=[0.4; 0.4; 0.2]/AFlo)
        "Matrix gain to split up heat gain in radiant, convective and latent gain"
        annotation (Placement(transformation(extent={{-66,42},{-46,62}})));
      parameter Modelica.Media.Interfaces.Types.Temperature T_start_CR=Medium_CR.T_default
        "Start value of zone air temperature";
      Modelica.Blocks.Interfaces.RealInput Q_People "heat load from workers inside the cold room"
        annotation (Placement(transformation(extent={{-126,32},{-86,72}})));
      parameter Modelica.Units.SI.ThermalConductance G=0.001
        "Constant thermal conductance of material";
    equation
      connect(CR_Zone.weaBus, weaBus1) annotation (Line(
          points={{19.9,47.9},{20,47.9},{20,86},{54,86},{54,100}},
          color={255,204,51},
          thickness=0.5));
      connect(preTem.port,thermalConductor. port_a) annotation (Line(points={{-52,-2},
              {-50,-1},{-12,-1}},                color={191,0,0}));
      connect(G_FC.y, thermalConductor.u) annotation (Line(points={{-27,16},{-22,16},
              {-22,7.8},{-13.1,7.8}}, color={0,0,127}));
      connect(thermalConductor.port_b, CR_Zone.surf_conBou[1])
        annotation (Line(points={{10,-1},{8,0},{8,13.75}}, color={191,0,0}));
      connect(CR_Zone.surf_conBou[2], thermalConductor.port_b)
        annotation (Line(points={{8,14.25},{10,14},{10,-1}}, color={191,0,0}));
      connect(weaBus1.TDryBul, preTem.T) annotation (Line(
          points={{54.05,100.05},{54.05,-18},{-84,-18},{-84,-2},{-74,-2}},
          color={255,204,51},
          thickness=0.5), Text(
          string="%first",
          index=-1,
          extent={{-6,3},{-6,3}},
          horizontalAlignment=TextAlignment.Right));
      connect(CR_Zone.ports, ports_Air_CR) annotation (Line(points={{-13,20},{-22,20},
              {-22,32},{-100,32},{-100,-63}}, color={0,127,255}));
      connect(CR_Zone.heaPorAir, heaPorAir1)
        annotation (Line(points={{1,30},{50,30},{50,16},{100,16}},
                                                   color={191,0,0}));
      connect(CR_Zone.heaPorRad, heaPorRad1) annotation (Line(points={{1,26.2},{82,26.2},
              {82,-68},{100,-68}},
                                 color={191,0,0}));
      connect(T_CR.T, T_in_CR) annotation (Line(points={{83,52},{94,52},{94,72},
              {108,72}},             color={0,0,127}));
      connect(T_CR.port, heaPorAir1) annotation (Line(points={{62,52},{58,52},{
              58,28},{84,28},{84,16},{100,16}},
                         color={191,0,0}));
      connect(gai.y, CR_Zone.qGai_flow) annotation (Line(points={{-45,52},{-42,52},{
              -42,38},{-19.6,38},{-19.6,38}}, color={0,0,127}));
      connect(Q_People, gai.u[1])
        annotation (Line(points={{-106,52},{-68,52}}, color={0,0,127}));
      connect(T_in_CR, T_in_CR)
        annotation (Line(points={{108,72},{108,72}}, color={0,0,127}));
      annotation (Icon(coordinateSystem(preserveAspectRatio=false), graphics={
            Rectangle(
              extent={{-80,-100},{0,-40}},
              lineColor={0,0,0},
              fillColor={215,215,215},
              fillPattern=FillPattern.Solid,
              lineThickness=0.5),
            Rectangle(
              extent={{0,20},{80,80}},
              lineColor={0,0,0},
              fillColor={197,219,227},
              fillPattern=FillPattern.None,
              lineThickness=0.5),
            Polygon(
              points={{-80,-40},{0,80},{80,80},{0,-40},{-80,-40}},
              lineColor={0,0,0},
              fillColor={215,215,215},
              fillPattern=FillPattern.Solid,
              lineThickness=0.5),
            Polygon(
              points={{0,-100},{0,-40},{80,80},{80,22},{0,-100}},
              lineColor={0,0,0},
              fillColor={215,215,215},
              fillPattern=FillPattern.Solid,
              lineThickness=0.5),
            Rectangle(
              extent={{-60,-60},{-20,-100}},
              lineColor={0,0,0},
              lineThickness=0.5,
              fillColor={217,231,249},
              fillPattern=FillPattern.Solid),
            Text(
              extent={{-122,54},{-76,28}},
              textColor={28,108,200},
              textString="Q_people",
              textStyle={TextStyle.Bold}),
            Text(
              extent={{76,6},{122,-20}},
              textColor={238,46,47},
              textStyle={TextStyle.Bold},
              textString="Air"),
            Text(
              extent={{76,-78},{122,-104}},
              textColor={238,46,47},
              textStyle={TextStyle.Bold},
              textString="Rad"),
            Text(
              extent={{88,62},{134,36}},
              textColor={28,108,200},
              textStyle={TextStyle.Bold},
              textString="T_CR")}),             Diagram(coordinateSystem(
              preserveAspectRatio=false), graphics={
            Rectangle(extent={{-78,-28},{76,-98}},   lineColor={28,108,200}, pattern=LinePattern.Dash),
            Text(
              extent={{-72,-34},{18,-36}},
              textColor={28,108,200},
              textString="Thermal Envelope")}),
        experiment(
          StartTime=10368000,
          StopTime=10800000,
          __Dymola_Algorithm="Dassl"),
        Documentation(info="<html>
<p>This model represents the <b>thermal structure of the cold room</b> used in the AGRI-COOL system.</p><p>The core of the model is based on the <span style=\"font-family: Courier New;\">AGRI_COOL.Buildings.ThermalZones.Detailed.MixedAir</span> component, which dynamically captures the energy balance and air temperature inside the cold room.</p>
<p>All relevant <b>construction material data records</b>&mdash;including walls, floor, and insulation layers&mdash;are integrated to represent the physical characteristics of the building envelope. These materials define how heat is transferred through the cold room&rsquo;s boundaries, ensuring realistic thermal behavior under varying outdoor and internal conditions.</p>
</html>"));
    end ColdROOM_V01;

  end Cold_Room;

  package Cooling_Loads
    "This package contains models that calculate the dynamic cooling demand of the cold room."

    package Infiltration_load
      "this package contains models that are responsible for airflow between coldr room and outdoor air"
      model Infiltration_Door
        "This model computes the infiltration heat loat as air stream that enters the cold room with different temperature and relative humidity when door is open, or the air leakage from seals."
        replaceable package Medium_CR = Modelica.Media.Interfaces.PartialMedium
        "Air medium in the cold room";
        parameter Real VFlo(unit="m3") = 4.6*11*4 "Room Volume";
        AGRI_COOL.Buildings.Examples.VAVReheat.BaseClasses.RoomLeakage Inf_Envelope(
          redeclare package Medium = Medium_CR,
          VRoo=VFlo,
          s=4.6/11,
          azi=AGRI_COOL.Buildings.Types.Azimuth.W,
          final use_windPressure=true)
          "Model for air infiltration through the envelope"
          annotation (Placement(transformation(extent={{-22,24},{22,76}})));
        AGRI_COOL.Buildings.Airflow.Multizone.DoorOperable
                                   opeNorCor(
          redeclare package Medium = Medium_CR,
          wOpe=1.4,
          hOpe=2.4,
          LClo=20*1E-4)
          "Opening between perimeter3 and core"
          annotation (Placement(transformation(extent={{-16,-60},{10,-34}})));
        AGRI_COOL.Buildings.BoundaryConditions.WeatherData.Bus weaBus1
                                                  "Bus with weather data"
          annotation (Placement(transformation(extent={{-110,40},{-90,60}})));
        Modelica.Fluid.Interfaces.FluidPort_b port_b_env(redeclare package Medium =
              Medium_CR)
          annotation (Placement(transformation(extent={{90,40},{110,60}})));
        Modelica.Blocks.Interfaces.RealInput Door_Signal
          "Opening signal, 0=closed, 1=open"
          annotation (Placement(transformation(extent={{-130,-68},{-90,-28}})));
        Modelica.Fluid.Interfaces.FluidPort_a port_a_out(redeclare package Medium =
              Medium_CR)
          "Fluid connector a1 (positive design flow direction is from port_a1 to port_b1)"
          annotation (Placement(transformation(extent={{-110,-10},{-90,10}})));
        Modelica.Fluid.Interfaces.FluidPort_b port_b_out(redeclare package Medium =
              Medium_CR)
          "Fluid connector b2 (positive design flow direction is from port_a2 to port_b2)"
          annotation (Placement(transformation(extent={{-110,-90},{-90,-70}})));
        Modelica.Fluid.Interfaces.FluidPort_b port_b_in(redeclare package Medium =
              Medium_CR)
          "Fluid connector b1 (positive design flow direction is from port_a1 to port_b1)"
          annotation (Placement(transformation(extent={{92,-10},{112,10}})));
        Modelica.Fluid.Interfaces.FluidPort_a port_a_in(redeclare package Medium =
              Medium_CR)
          "Fluid connector a2 (positive design flow direction is from port_a2 to port_b2)"
          annotation (Placement(transformation(extent={{90,-90},{110,-70}})));
      equation
        connect(Inf_Envelope.weaBus, weaBus1) annotation (Line(
            points={{-22,50},{-100,50}},
            color={255,204,51},
            thickness=0.5));
        connect(Inf_Envelope.port_b, port_b_env)
          annotation (Line(points={{22,50},{100,50}}, color={0,127,255}));
        connect(opeNorCor.y, Door_Signal) annotation (Line(points={{-17.3,-47},{-17.3,
                -48},{-110,-48}}, color={0,0,127}));
        connect(opeNorCor.port_a1, port_a_out) annotation (Line(points={{-16,-39.2},{-58,
                -39.2},{-58,0},{-100,0}}, color={0,127,255}));
        connect(opeNorCor.port_b2, port_b_out) annotation (Line(points={{-16,-54.8},{-58,
                -54.8},{-58,-80},{-100,-80}}, color={0,127,255}));
        connect(opeNorCor.port_b1, port_b_in) annotation (Line(points={{10,-39.2},{58,
                -39.2},{58,0},{102,0}}, color={0,127,255}));
        connect(opeNorCor.port_a2, port_a_in) annotation (Line(points={{10,-54.8},{34,
                -54.8},{34,-56},{54,-56},{54,-80},{100,-80}}, color={0,127,255}));
        annotation (Icon(coordinateSystem(preserveAspectRatio=false), graphics={Line(
                points={{-80,20},{82,20},{32,46}},
                color={28,108,200},
                thickness=1), Line(
                points={{80,-20},{-82,-20},{-32,-46}},
                color={28,108,200},
                thickness=1)}), Diagram(coordinateSystem(preserveAspectRatio=false)));
      end Infiltration_Door;

      model Infiltration_ZoneFlow
        "This model computes the infiltration heat load as air stream that enters the cold room with different temperature and relative humidity when door is open, or the air leakage from seals."
        replaceable package Medium_CR = Modelica.Media.Interfaces.PartialMedium
        "Air medium in the cold room";
        parameter Real VFlo(unit="m3") = 4.6*11*4 "Room Volume";
        AGRI_COOL.Buildings.Examples.VAVReheat.BaseClasses.RoomLeakage Inf_Envelope(
          redeclare package Medium = Medium_CR,
          VRoo=VFlo,
          s=4.6/11,
          azi=AGRI_COOL.Buildings.Types.Azimuth.W,
          final use_windPressure=true)
          "Model for air infiltration through the envelope"
          annotation (Placement(transformation(extent={{-22,24},{22,76}})));
        Buildings.Airflow.Multizone.ZonalFlow_m_flow
                                   opeNorCor(
          redeclare package Medium = Medium_CR)
          "Opening between perimeter3 and core"
          annotation (Placement(transformation(extent={{-16,-60},{10,-34}})));
        AGRI_COOL.Buildings.BoundaryConditions.WeatherData.Bus weaBus1
                                                  "Bus with weather data"
          annotation (Placement(transformation(extent={{-110,40},{-90,60}})));
        Modelica.Fluid.Interfaces.FluidPort_b port_b_env(redeclare package Medium =
              Medium_CR)
          annotation (Placement(transformation(extent={{90,40},{110,60}})));
        Modelica.Blocks.Interfaces.RealInput mAB
          "Opening signal, 0=closed, 1=open"
          annotation (Placement(transformation(extent={{-130,-54},{-90,-14}})));
        Modelica.Fluid.Interfaces.FluidPort_a port_a_out(redeclare package Medium =
              Medium_CR)
          "Fluid connector a1 (positive design flow direction is from port_a1 to port_b1)"
          annotation (Placement(transformation(extent={{-110,-10},{-90,10}})));
        Modelica.Fluid.Interfaces.FluidPort_b port_b_out(redeclare package Medium =
              Medium_CR)
          "Fluid connector b2 (positive design flow direction is from port_a2 to port_b2)"
          annotation (Placement(transformation(extent={{-110,-90},{-90,-70}})));
        Modelica.Fluid.Interfaces.FluidPort_b port_b_in(redeclare package Medium =
              Medium_CR)
          "Fluid connector b1 (positive design flow direction is from port_a1 to port_b1)"
          annotation (Placement(transformation(extent={{92,-10},{112,10}})));
        Modelica.Fluid.Interfaces.FluidPort_a port_a_in(redeclare package Medium =
              Medium_CR)
          "Fluid connector a2 (positive design flow direction is from port_a2 to port_b2)"
          annotation (Placement(transformation(extent={{90,-90},{110,-70}})));
        Modelica.Blocks.Interfaces.RealInput mBA
          "Mass flow rate from B to A, positive if flow from port_a2 to port_b2"
          annotation (Placement(transformation(
              extent={{-20,-20},{20,20}},
              rotation=180,
              origin={106,-34})));
      equation
        connect(Inf_Envelope.weaBus, weaBus1) annotation (Line(
            points={{-22,50},{-100,50}},
            color={255,204,51},
            thickness=0.5));
        connect(Inf_Envelope.port_b, port_b_env)
          annotation (Line(points={{22,50},{100,50}}, color={0,127,255}));
        connect(opeNorCor.port_a1, port_a_out) annotation (Line(points={{-16,-39.2},{-58,
                -39.2},{-58,0},{-100,0}}, color={0,127,255}));
        connect(opeNorCor.port_b2, port_b_out) annotation (Line(points={{-16,-54.8},{-58,
                -54.8},{-58,-80},{-100,-80}}, color={0,127,255}));
        connect(opeNorCor.port_b1, port_b_in) annotation (Line(points={{10,-39.2},{58,
                -39.2},{58,0},{102,0}}, color={0,127,255}));
        connect(opeNorCor.port_a2, port_a_in) annotation (Line(points={{10,-54.8},{34,
                -54.8},{34,-56},{54,-56},{54,-80},{100,-80}}, color={0,127,255}));
        connect(mAB, opeNorCor.mAB_flow)
          annotation (Line(points={{-110,-34},{-17.3,-34}}, color={0,0,127}));
        connect(opeNorCor.mBA_flow, mBA) annotation (Line(points={{11.3,-60},{
                11.3,-64},{80,-64},{80,-34},{106,-34}}, color={0,0,127}));
        annotation (Icon(coordinateSystem(preserveAspectRatio=false), graphics={Line(
                points={{-80,20},{82,20},{32,46}},
                color={28,108,200},
                thickness=1), Line(
                points={{80,-20},{-82,-20},{-32,-46}},
                color={28,108,200},
                thickness=1)}), Diagram(coordinateSystem(preserveAspectRatio=false)));
      end Infiltration_ZoneFlow;
    end Infiltration_load;

    package People
      "this package computes the heat load that people who are working in the cold room are adding to it."
      model People
        "this model computes the heat load that people who are working in the cold room are adding to it."
        parameter Real n=2 "number of people working in cold room.";
        Modelica.Blocks.Interfaces.RealInput T_in_K
          annotation (Placement(transformation(extent={{-130,40},{-90,80}})));
        Modelica.Blocks.Math.Gain gain(k=-6)
          annotation (Placement(transformation(extent={{-40,28},{-20,48}})));
        Modelica.Blocks.Sources.Constant const(k=272)
          annotation (Placement(transformation(extent={{-48,-18},{-28,2}})));
        Modelica.Blocks.Math.Add add
          annotation (Placement(transformation(extent={{10,12},{30,32}})));
        Modelica.Blocks.Interfaces.RealOutput Q_people
          "Connector of Real output signal" annotation (Placement(transformation(
                extent={{98,-28},{154,28}}), iconTransformation(extent={{98,-28},{154,
                  28}})));
        Modelica.Blocks.Math.Product product1
          annotation (Placement(transformation(extent={{64,6},{84,26}})));
        Modelica.Blocks.Interfaces.RealInput t_people
          "Connector of Real input signal 2"
          annotation (Placement(transformation(extent={{-128,-80},{-88,-40}})));
        Modelica.Blocks.Sources.Constant const1(k=-273.15)
          annotation (Placement(transformation(extent={{-10,-10},{10,10}},
              rotation=90,
              origin={-84,16})));
        Modelica.Blocks.Math.Add add1
          annotation (Placement(transformation(extent={{-76,44},{-56,64}})));
        Modelica.Blocks.Math.Product product2
          annotation (Placement(transformation(extent={{-6,-70},{14,-50}})));
        Modelica.Blocks.Sources.RealExpression realExpression(y=n)
          annotation (Placement(transformation(extent={{-50,-80},{-30,-60}})));
      equation
        connect(gain.y, add.u1) annotation (Line(points={{-19,38},{-12,38},{-12,
                30},{8,30},{8,28}},
                               color={0,0,127}));
        connect(const.y, add.u2) annotation (Line(points={{-27,-8},{-12,-8},{-12,12},
                {8,12},{8,16}}, color={0,0,127}));
        connect(add.y, product1.u1)
          annotation (Line(points={{31,22},{62,22}}, color={0,0,127}));
        connect(product1.y, Q_people) annotation (Line(points={{85,16},{92,16},{92,0},
                {126,0}}, color={0,0,127}));
        connect(T_in_K, add1.u1)
          annotation (Line(points={{-110,60},{-78,60}}, color={0,0,127}));
        connect(const1.y, add1.u2) annotation (Line(points={{-84,27},{-90,27},{
                -90,48},{-78,48}},  color={0,0,127}));
        connect(add1.y, gain.u) annotation (Line(points={{-55,54},{-52,54},{-52,
                38},{-42,38}}, color={0,0,127}));
        connect(t_people, product2.u1) annotation (Line(points={{-108,-60},{-68,-60},{
                -68,-50},{-8,-50},{-8,-54}}, color={0,0,127}));
        connect(product2.y, product1.u2) annotation (Line(points={{15,-60},{28,-60},{28,
                -12},{46,-12},{46,10},{62,10}}, color={0,0,127}));
        connect(realExpression.y, product2.u2) annotation (Line(points={{-29,-70},{-20,
                -70},{-20,-66},{-8,-66}}, color={0,0,127}));
        annotation (Icon(coordinateSystem(preserveAspectRatio=false), graphics={
              Ellipse(
                extent={{-28,80},{26,28}},
                lineColor={28,108,200},
                lineThickness=1),
              Line(
                points={{0,28},{0,-42}},
                color={28,108,200},
                thickness=1),
              Line(
                points={{0,-42},{-40,-78}},
                color={28,108,200},
                thickness=1),
              Line(
                points={{0,-42},{42,-80}},
                color={28,108,200},
                thickness=1),
              Line(
                points={{0,0},{-22,-18}},
                color={28,108,200},
                thickness=1),
              Line(
                points={{0,0},{22,-18}},
                color={28,108,200},
                thickness=1),
              Text(
                extent={{-130,46},{-84,20}},
                textColor={28,108,200},
                textStyle={TextStyle.Bold},
                textString="T_CR (K)")}),
                                       Diagram(coordinateSystem(preserveAspectRatio=
                  false)));

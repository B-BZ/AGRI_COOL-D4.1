  package Battery
    model OffGridPv_supCap
      // --- PV system producing power as Real (W) ---
    extends Modelica.Icons.Example;
      Modelica.Blocks.Interfaces.RealOutput ACOutputPower(
          final quantity="Power", final unit="W")
        "PV DC power out (for plotting)"
        annotation (Placement(transformation(extent={{-10,-10},{10,10}}, origin={96,78})));

      // --- Supercap + electrical side (DC bus is superCap.p node) ---
      Modelica.Electrical.Batteries.BatteryStacks.SuperCap superCap(
        Vnom=48,
        C=5000,          Rs=0.002, Idis=0.05, useHeatPort=false)
        annotation (Placement(transformation(extent={{-10,10},{10,-10}}, origin={82,-124})));

      Modelica.Electrical.Analog.Basic.Ground ground
        annotation (Placement(transformation(extent={{50,-232},{70,-212}})));

      // PV-side controlled current source (injects surplus into the DC bus)
      Modelica.Electrical.Analog.Sources.SignalCurrent iSrcPV
        annotation (Placement(transformation(extent={{10,-10},{-10,10}}, rotation=90, origin={-104,
                -128})));

      // Load-side controlled current source (draws 200 W from DC bus)
      Modelica.Electrical.Analog.Sources.SignalCurrent iSinkLoad
        annotation (Placement(transformation(extent={{10,-10},{-10,10}}, rotation=180, origin={-52,-130})));

      // Power sensor on the PV/charge path to track energy delivered to the cap
      Modelica.Electrical.Analog.Sensors.PowerSensor powerSensor
        annotation (Placement(transformation(extent={{44,-102},{64,-82}})));

      Modelica.Blocks.Continuous.Integrator energy(u(unit="W"), y(unit="J"))
        annotation (Placement(transformation(extent={{6,-6},{-6,6}},     origin={-44,-88})));

      // =========================
      // Measurements and helpers
      // =========================
      // Cap/bus voltage measurement
      Modelica.Electrical.Analog.Sensors.VoltageSensor vCap
        annotation (Placement(transformation(extent={{-10,-10},{10,10}}, origin={10,-144})));

      // Avoid divide-by-zero at low voltage
      Modelica.Blocks.Nonlinear.Limiter vFloor(uMin=5, uMax=1e6)
        annotation (Placement(transformation(extent={{-10,-10},{10,10}}, origin={82,-32})));

      // 1) PV power path: clip at >= 0, then apply efficiency
      Modelica.Blocks.Nonlinear.Limiter pLim(uMin=0, uMax=1e9)
        annotation (Placement(transformation(extent={{-156,-24},{-136,-4}})));
      Modelica.Blocks.Sources.Constant eta_AC2DC(k=0.95) "Converter efficiency"
        annotation (Placement(transformation(extent={{-14,-14},{6,6}})));

      // 2) Equipment load demand (200 W), with under-voltage cutoff
      parameter Real Pload = 5000 "Equipment rated power [W]";
      parameter Real VminLoad = 10 "Equipment undervoltage cutoff [V]";
      Modelica.Blocks.Sources.Constant PEquip_W(k=Pload) annotation (Placement(
            transformation(extent={{-10,-10},{10,10}}, origin={-290,-116})));
      // Select effective load power: 200 W when Vcap>VminLoad, else 0 W
      Modelica.Blocks.Logical.Switch loadPowerSel
        annotation (Placement(transformation(extent={{-10,-10},{10,10}}, origin={-212,
                -136})));

      // 3) Compute Equipment sink current: iEquipment = PEquipment_eff / max(Vcap, vFloor)
      Modelica.Blocks.Math.Division pEquip_over_v annotation (Placement(
            transformation(extent={{10,-10},{-10,10}}, origin={-332,-4})));
      Modelica.Blocks.Nonlinear.Limiter iEquipLim(uMin=0, uMax=100)
        "Limit Equipment current draw [A]" annotation (Placement(transformation(extent={{-10,
                -10},{10,10}}, origin={-352,-42})));
      Modelica.Blocks.Math.Gain iEquip(k=+1) "Make it a rise (Positive into bus)"
        annotation (Placement(transformation(extent={{-10,-10},{10,10}}, origin={-298,
                -70})));

      // 4) Surplus power for charging: Psur = max(Ppv_pos - PEquipment_eff, 0)
      //Modelica.Blocks.Math.MinMax subP( loadPowerFirst=true)
      //"Outputs yMin=min(u1,u2), yMax=max(u1,u2); here we use it to compute Psur"
      //annotation (Placement(transformation(extent={{-10,-10},{10,10}}, origin={-42,-72})));
      Modelica.Blocks.Math.Add pvMinusLoad(k1=+1, k2=-1)
        annotation (Placement(transformation(extent={{-10,-10},{10,10}}, origin={-122,-60})));
      Modelica.Blocks.Nonlinear.Limiter pSurLim(uMin=0, uMax=1e9)
        annotation (Placement(transformation(extent={{-10,-10},{10,10}}, origin={-14,-62})));
      Modelica.Blocks.Math.Product pEff
        annotation (Placement(transformation(extent={{-10,-10},{10,10}}, origin={34,-56})));
                                         // eta * Psur
      // 5) Convert Psur to charging current: iPV = eta*Psur / max(Vcap, vFloor)
      Modelica.Blocks.Math.Division pOverV
        annotation (Placement(transformation(extent={{-10,-10},{10,10}}, origin={154,-34})));
      parameter Real Imax = 50 "Max charge current [A]";
      Modelica.Blocks.Nonlinear.Limiter iLim(uMin=0, uMax=Imax)
        annotation (Placement(transformation(extent={{-10,-10},{10,10}}, origin={186,-54})));
      parameter Real Vmax = 60 "Overvoltage stop [V]";
      Modelica.Blocks.Sources.Constant zero(k=0)
        annotation (Placement(transformation(extent={{-10,-10},{10,10}}, origin={178,-138})));
      Modelica.Blocks.Logical.Switch iEnable
        annotation (Placement(transformation(extent={{-10,-10},{10,10}}, origin={236,-90})));

      Modelica.Blocks.Math.Gain iPVNeg(k=-1) "Make it a sink (negative into bus)"
        annotation (Placement(transformation(extent={{10,-10},{-10,10}}, origin={182,
                -188})));
      Modelica.Blocks.Logical.Switch swActDisch
        annotation (Placement(transformation(extent={{-242,-82},{-222,-62}})));
      Modelica.Blocks.Logical.LessEqualThreshold DischActive(threshold=0)
        annotation (Placement(transformation(extent={{10,-10},{-10,10}}, origin={
                -212,-40})));
      Modelica.Blocks.Sources.Constant zero1(k=0)
        annotation (Placement(transformation(extent={{-10,-10},{10,10}}, origin={-362,
                -124})));
      Modelica.Electrical.Analog.Sensors.PowerSensor powerSensor1
        annotation (Placement(transformation(extent={{-42,-164},{-22,-144}})));
      Modelica.Blocks.Math.Add SumEnergy annotation (Placement(transformation(
              extent={{6,-6},{-6,6}}, origin={-12,-94})));
       parameter Real total_A = 100 "panel total area [m2]";
      PV.PvPanels                                pvPanels(nPV=integer(total_A/pvPanels.A))
        annotation (Placement(transformation(extent={{-180,58},{-132,94}})));
      AGRI_COOL.Buildings.BoundaryConditions.WeatherData.ReaderTMY3 weaDat1(
          computeWetBulbTemperature=false, filNam=
            ModelicaServices.ExternalReferences.loadResource("modelica://AGRI_COOL/Inputs/SOM_BN_Mogadishu.Intl.AP.632600_TMYx.2009-2023.mos"))
        "Weather reader (TMY3)"
        annotation (Placement(transformation(extent={{-250,90},{-230,110}})));
      Modelica.Blocks.Logical.Hysteresis hysteresis(
        uLow=10,
        uHigh=Vmax,
        pre_y_start=true)
        annotation (Placement(transformation(extent={{156,-114},{176,-94}})));
      Modelica.Blocks.Logical.Not not1
        annotation (Placement(transformation(extent={{186,-100},{206,-80}})));
      Modelica.Blocks.Logical.Hysteresis HysVOK(
        uLow=VminLoad,
        uHigh=VminLoad + 20,
        pre_y_start=true)
        annotation (Placement(transformation(extent={{-326,-174},{-306,-154}})));
      Modelica.Blocks.Interfaces.RealOutput SOC_supCap
        "SOC_supCap (for plotting)" annotation (Placement(transformation(extent={
                {-15,-15},{15,15}}, origin={315,69}), iconTransformation(extent={
                {-15,-15},{15,15}}, origin={315,69})));
      Modelica.Blocks.Sources.RealExpression realExpression(y=(vCap.v^2)/(Vmax^2))
        annotation (Placement(transformation(extent={{208,-40},{278,-4}})));
      Modelica.Blocks.Math.Gain iRatioEquip(k=0.2)
        "SuperCap only supply 20% of load" annotation (Placement(transformation(
              extent={{10,-10},{-10,10}}, origin={-274,-12})));
      Modelica.Blocks.Math.Add add
        annotation (Placement(transformation(extent={{-262,12},{-274,24}})));
      Modelica.Blocks.Sources.Constant smallValue(k=1e-4)
        annotation (Placement(transformation(extent={{-224,0},{-234,10}})));
    equation
      // --- PV outputs (plotting only) ---
      // Weather bus to PV
      // --- DC bus and ground ---
      connect(superCap.n, ground.p)
        annotation (Line(points={{92,-124},{100,-124},{100,-176},{60,-176},{60,-212}},
                                                                                     color={0,0,255}));
      // PV charge path: current source → powerSensor → supercap.p
      connect(iSrcPV.n, ground.p)
        annotation (Line(points={{-104,-138},{-104,-168},{60,-168},{60,-212}},
                                                                             color={0,0,255}));
      connect(iSrcPV.p, powerSensor.pc)
        annotation (Line(points={{-104,-118},{-104,-110},{26,-110},{26,-92},{44,
              -92}},                                                               color={0,0,255}));
      connect(powerSensor.nc, superCap.p)
        annotation (Line(points={{64,-92},{66,-92},{66,-124},{72,-124}}, color={0,0,255}));
      connect(powerSensor.nv, ground.p)
        annotation (Line(points={{54,-102},{54,-120},{24,-120},{24,-148},{60,-148},
              {60,-212}},                                                  color={0,0,255}));
      connect(powerSensor.pc, powerSensor.pv)
        annotation (Line(points={{44,-92},{32,-92},{32,-78},{54,-78},{54,-82}},
                                                                              color={0,0,255}));
      // Load sink path: current source from DC bus to ground (negative current command)
      connect(iSinkLoad.n, ground.p)
        annotation (Line(points={{-42,-130},{-20,-130},{-20,-120},{24,-120},{24,-148},
              {60,-148},{60,-212}},                                          color={0,0,255}));
      // Energy integration of power into the cap
      // --- Measurements and helpers ---
      // Measure Vcap between superCap.p and ground
      connect(vCap.p, superCap.p)
        annotation (Line(points={{0,-144},{-16,-144},{-16,-124},{72,-124}},   color={0,0,255}));
      connect(vCap.n, ground.p)
        annotation (Line(points={{20,-144},{60,-144},{60,-212}}, color={0,0,255}));
      // Voltage floor and routing
      connect(vCap.v, vFloor.u)
        annotation (Line(points={{10,-155},{10,-192},{-160,-192},{-160,-100},{
              -104,-100},{-104,-40},{-84,-40},{-84,-36},{60,-36},{60,-32},{70,-32}},                     color={0,0,127}));
      // --- PV power pre-processing ---
      // --- Equip load enable and current sink calculation ---
      connect(PEquip_W.y, loadPowerSel.u1) annotation (Line(points={{-279,-116},
              {-232,-116},{-232,-128},{-224,-128}},       color={0,0,127}));
      // desired 200 W
      // selector: true when V > VminLoad
      // else 0 W
      // iEquip = PEquip_eff / max(Vcap, vFloor)
      connect(pEquip_over_v.y, iEquipLim.u) annotation (Line(points={{-343,-4},{-374,
              -4},{-374,-42},{-364,-42}}, color={0,0,127}));
      connect(iEquipLim.y, iEquip.u) annotation (Line(points={{-341,-42},{-320,-42},
              {-320,-70},{-310,-70}}, color={0,0,127}));
      // negative command → sink from bus
      // --- Surplus computation for charging ---
      // pvMinusLoad = Ppv_pos - PEquip_eff
      connect(pLim.y, pvMinusLoad.u1)
        annotation (Line(points={{-135,-14},{-135,-16},{-128,-16},{-128,-44},{-144,-44},
              {-144,-54},{-134,-54}},                                      color={0,0,127}));
      connect(loadPowerSel.y, pvMinusLoad.u2)
        annotation (Line(points={{-201,-136},{-164,-136},{-164,-66},{-134,-66}},
                                                                   color={0,0,127}));
      // Psur = max(pvMinusLoad, 0)
      connect(pvMinusLoad.y, pSurLim.u)
        annotation (Line(points={{-111,-60},{-36,-60},{-36,-62},{-26,-62}},
                                                       color={0,0,127}));
      // pEff = eta * Psur
      connect(eta_AC2DC.y, pEff.u1) annotation (Line(points={{7,-4},{16,-4},{16,-50},
              {22,-50}}, color={0,0,127}));
      connect(pSurLim.y, pEff.u2)
        annotation (Line(points={{-3,-62},{22,-62}},color={0,0,127}));
      // iPV = (eta*Psur) / max(Vcap, vFloor)
      connect(pEff.y, pOverV.u1)
        annotation (Line(points={{45,-56},{52,-56},{52,-12},{140,-12},{140,-28},{142,
              -28}},                                                  color={0,0,127}));
      connect(vFloor.y, pOverV.u2)
        annotation (Line(points={{93,-32},{136,-32},{136,-40},{142,-40}},
                                                                        color={0,0,127}));
      connect(pOverV.y, iLim.u)
        annotation (Line(points={{165,-34},{168,-34},{168,-40},{174,-40},{174,-54}},
                                                     color={0,0,127}));
      // Over-voltage stop on charging
      connect(iLim.y, iEnable.u1)
        annotation (Line(points={{197,-54},{216,-54},{216,-82},{224,-82}},   color={0,0,127}));
      connect(zero.y, iEnable.u3)
        annotation (Line(points={{189,-138},{216,-138},{216,-98},{224,-98}},   color={0,0,127}));
      // Command the PV injection current source
      // Close the power sensor loop (unchanged)
      connect(iEnable.y, iPVNeg.u) annotation (Line(points={{247,-90},{250,-90},{
              250,-188},{194,-188}},        color={0,0,127}));
      connect(iPVNeg.y, iSrcPV.i) annotation (Line(points={{171,-188},{-120,-188},
              {-120,-146},{-124,-146},{-124,-128},{-116,-128}},
                                                          color={0,0,127}));
      connect(pvMinusLoad.y, DischActive.u) annotation (Line(points={{-111,-60},{
              -106,-60},{-106,-40},{-200,-40}}, color={0,0,127}));
      connect(iEquip.y, swActDisch.u1) annotation (Line(points={{-287,-70},{-254,-70},
              {-254,-64},{-244,-64}}, color={0,0,127}));
      connect(DischActive.y, swActDisch.u2) annotation (Line(points={{-223,-40},{
              -230,-40},{-230,-56},{-216,-56},{-216,-88},{-252,-88},{-252,-72},{
              -244,-72}}, color={255,0,255}));
      connect(zero1.y, loadPowerSel.u3) annotation (Line(points={{-351,-124},{
              -326,-124},{-326,-144},{-224,-144}}, color={0,0,127}));
      connect(zero1.y, swActDisch.u3) annotation (Line(points={{-351,-124},{-324,
              -124},{-324,-96},{-252,-96},{-252,-80},{-244,-80}}, color={0,0,127}));
      connect(swActDisch.y, iSinkLoad.i) annotation (Line(points={{-221,-72},{
              -158,-72},{-158,-112},{-68,-112},{-68,-150},{-52,-150},{-52,-142}},
            color={0,0,127}));
      connect(superCap.p, powerSensor1.nc) annotation (Line(points={{72,-124},{
              -16,-124},{-16,-154},{-22,-154}}, color={0,0,255}));
      connect(powerSensor1.pc, iSinkLoad.p) annotation (Line(points={{-42,-154},{
              -70,-154},{-70,-130},{-62,-130}}, color={0,0,255}));
      connect(powerSensor1.pv, powerSensor1.pc) annotation (Line(points={{-32,
              -144},{-32,-138},{-14,-138},{-14,-170},{-48,-170},{-48,-154},{-42,
              -154}}, color={0,0,255}));
      connect(powerSensor1.nv, ground.p) annotation (Line(points={{-32,-164},{-32,
              -168},{60,-168},{60,-212}}, color={0,0,255}));
      connect(powerSensor.power, SumEnergy.u1) annotation (Line(points={{44,-103},
              {44,-108},{2,-108},{2,-90.4},{-4.8,-90.4}}, color={0,0,127}));
      connect(powerSensor1.power, SumEnergy.u2) annotation (Line(points={{-42,
              -165},{-42,-172},{-12,-172},{-12,-104},{0,-104},{0,-97.6},{-4.8,
              -97.6}}, color={0,0,127}));
      connect(SumEnergy.y, energy.u) annotation (Line(points={{-18.6,-94},{-32,
              -94},{-32,-88},{-36.8,-88}}, color={0,0,127}));
      connect(weaDat1.weaBus, pvPanels.weaBus) annotation (Line(
          points={{-230,100},{-173.25,100},{-173.25,89.35}},
          color={255,204,51},
          thickness=0.5));
      connect(pvPanels.P_total, ACOutputPower) annotation (Line(points={{-135.6,75.7},
              {80,75.7},{80,78},{96,78}}, color={0,0,127}));
      connect(pvPanels.P_total, pLim.u) annotation (Line(points={{-135.6,75.7},{-126,
              75.7},{-126,2},{-166,2},{-166,-14},{-158,-14}}, color={0,0,127}));
      connect(vCap.v, hysteresis.u) annotation (Line(points={{10,-155},{10,-160},{144,
              -160},{144,-104},{154,-104}}, color={0,0,127}));
      connect(hysteresis.y, not1.u) annotation (Line(points={{177,-104},{184,-104},{
              184,-90}}, color={255,0,255}));
      connect(not1.y, iEnable.u2)
        annotation (Line(points={{207,-90},{224,-90}}, color={255,0,255}));
      connect(vCap.v, HysVOK.u) annotation (Line(points={{10,-155},{10,-192},{-160,-192},
              {-160,-180},{-336,-180},{-336,-164},{-328,-164}}, color={0,0,127}));
      connect(HysVOK.y, loadPowerSel.u2) annotation (Line(points={{-305,-164},{-298,
              -164},{-298,-136},{-224,-136}}, color={255,0,255}));
      connect(realExpression.y, SOC_supCap) annotation (Line(points={{281.5,-22},
              {292,-22},{292,69},{315,69}}, color={0,0,127}));
      connect(loadPowerSel.y, iRatioEquip.u) annotation (Line(points={{-201,-136},
              {-201,-12},{-262,-12}}, color={0,0,127}));
      connect(iRatioEquip.y, pEquip_over_v.u1) annotation (Line(points={{-285,-12},
              {-310,-12},{-310,2},{-320,2}}, color={0,0,127}));
      connect(vFloor.y, add.u1) annotation (Line(points={{93,-32},{98,-32},{98,14},
              {-256,14},{-256,21.6},{-260.8,21.6}}, color={0,0,127}));
      connect(smallValue.y, add.u2) annotation (Line(points={{-234.5,5},{-260.8,5},
              {-260.8,14.4}}, color={0,0,127}));
      connect(add.y, pEquip_over_v.u2) annotation (Line(points={{-274.6,18},{-298,
              18},{-298,-14},{-312,-14},{-312,-10},{-320,-10}}, color={0,0,127}));
      annotation (
        Icon(coordinateSystem(preserveAspectRatio=false, extent={{-400,-240},{320,120}})),
        Diagram(coordinateSystem(preserveAspectRatio=false, extent={{-400,-240},{320,
                120}}),                                                                      graphics={
            Rectangle(extent={{-172,30},{280,-232}}, lineColor={28,108,200}, pattern=LinePattern.Dash),
            Rectangle(extent={{-390,32},{-180,-232}},lineColor={28,108,200}, pattern=LinePattern.Dash),
            Rectangle(extent={{-70,-70},{114,-180}}, lineColor={28,108,200}, pattern=LinePattern.Dash),
            Text(
              extent={{182,36},{272,-4}},
              textColor={28,108,200},
              textString="Power Distribution"),
            Text(
              extent={{-386,30},{-314,16}},
              textColor={28,108,200},
              textString="Equipment Load"),
            Text(
              extent={{-366,126},{-262,64}},
              textColor={28,108,200},
              textString="AC Pv Penals
"),         Rectangle(extent={{-370,118},{166,36}},  lineColor={28,108,200}, pattern=LinePattern.Dash),
            Text(
              extent={{78,-72},{114,-90}},
              textColor={28,108,200},
              textString="DC supCap")}),
        Documentation(info="<html>
<p><b>PV-first Equipment load (200-2000 W), surplus to supercap, night discharge</b></p>
<p>This model adds a constant-power load (Equipment) with priority use of PV power. Surplus PV charges the supercap; when PV is insufficient, the supercap supplies the deficit.</p>
<ul>
<li><b>Equipment sink</b>: <code>iSinkLoad</code> draws <code>i = P_Equipment / max(V, V_floor)</code> from the DC bus when <code>Vcap &gt; VminLoad</code>.</li>
<li><b>Surplus charging</b>: <code>P_sur = max(P_pv - P_Equipment, 0)</code>, then <code>i = &eta; P_sur / max(V, V_floor)</code> into the supercap, limited by <code>Imax</code> and stopped at <code>Vmax</code>.</li>
<li><b>Night / deficit</b>: With PV low, <code>P_sur = 0</code>. The Equipment sink current discharges the supercap.</li>
<li>Safety: voltage floor avoids divide-by-zero; current limits protect sources; under-voltage cutoff avoids unrealistic load at very low V.</li>
</ul>
<p>Tune: <code>Pload</code> (W), <code>VminLoad</code> (V), <code>Imax</code> (A), <code>Vmax</code> (V), <code>eta</code>.</p>
</html>"),
        experiment(StopTime=432000, __Dymola_Algorithm="Dassl"));
    end OffGridPv_supCap;

    model equipmentLoad
      parameter Real Vmin_100 = 42 "Equipment undervoltage cutoff at 100% DOD [V]";
      parameter Real Vmax = 58 "Overvoltage stop [V]";

      parameter Real DOD = 75 "depth of discharge [%]";
      parameter Real Vmin = sqrt(Vmax^2 - ((DOD/100)* (Vmax^2 - Vmin_100^2)))
        "Equipment undervoltage cutoff computed from DOD [V]";
      Modelica.Blocks.Logical.Switch loadPowerSel
        annotation (Placement(transformation(extent={{-10,-10},{10,10}}, origin={122,-274})));
      Modelica.Blocks.Math.Division pEquip_over_v annotation (Placement(
            transformation(extent={{10,-10},{-10,10}}, origin={2,-142})));
      Modelica.Blocks.Nonlinear.Limiter iEquipLim(uMin=0, uMax=100)
        "Limit Equipment current draw [A]" annotation (Placement(transformation(extent={{-10,
                -10},{10,10}}, origin={-18,-180})));
      Modelica.Blocks.Math.Gain iEquip(k=+1) "Make it a rise (Positive into bus)"
        annotation (Placement(transformation(extent={{-10,-10},{10,10}}, origin={36,-208})));
      Modelica.Blocks.Logical.Switch swActDisch
        annotation (Placement(transformation(extent={{92,-220},{112,-200}})));
      Modelica.Blocks.Logical.LessEqualThreshold DischActive(threshold=0)
        annotation (Placement(transformation(extent={{10,-10},{-10,10}}, origin={122,-178})));
      Modelica.Blocks.Sources.Constant zero1(k=0)
        annotation (Placement(transformation(extent={{-10,-10},{10,10}}, origin={44,-244})));
      Modelica.Blocks.Logical.Hysteresis HysVOK(
        uLow=Vmin,
        uHigh=Vmax,
        pre_y_start=true)
        annotation (Placement(transformation(extent={{8,-312},{28,-292}})));
      Modelica.Blocks.Math.Gain iRatioEquip(k=1)
        "SuperCap only supply Gain% of load"
                                           annotation (Placement(transformation(
              extent={{10,-10},{-10,10}}, origin={60,-150})));
      Modelica.Blocks.Math.Add add
        annotation (Placement(transformation(extent={{72,-126},{60,-114}})));
      Modelica.Blocks.Sources.Constant smallValue(k=1e-4)
        annotation (Placement(transformation(extent={{110,-138},{100,-128}})));
      Modelica.Blocks.Nonlinear.Limiter pLim(uMin=0, uMax=1e9)
        annotation (Placement(transformation(extent={{336,-38},{356,-18}})));
      Modelica.Blocks.Math.Add pvMinusLoad(k1=+1, k2=-1)
        annotation (Placement(transformation(extent={{-10,-10},{10,10}}, origin={376,-226})));
      Modelica.Blocks.Interfaces.RealInput pTotal
        annotation (Placement(transformation(extent={{-86,34},{-46,74}}),
            iconTransformation(extent={{-86,34},{-46,74}})));
      Modelica.Blocks.Interfaces.RealInput vSupCap
        annotation (Placement(transformation(extent={{518,-376},{478,-336}})));
      Modelica.Blocks.Interfaces.RealOutput IsinkLoad annotation (Placement(
            transformation(extent={{-15,-15},{15,15}}, origin={511,-245}),
            iconTransformation(extent={{-15,-15},{15,15}}, origin={315,69})));
      Modelica.Blocks.Nonlinear.Limiter vFloor(uMin=5, uMax=1e6)
        annotation (Placement(transformation(extent={{-10,-10},{10,10}}, origin={486,-184})));
      Modelica.Blocks.Interfaces.RealInput P_L
        "Connector of first Real input signal"
        annotation (Placement(transformation(extent={{-122,-216},{-82,-176}})));
    equation
      connect(pEquip_over_v.y,iEquipLim. u) annotation (Line(points={{-9,-142},{-40,

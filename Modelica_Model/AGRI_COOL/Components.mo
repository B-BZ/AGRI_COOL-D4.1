        Placement(transformation(extent={{100,-10},{120,10}}, rotation=0),
                  iconTransformation(extent={{100,-10},{120,10}}, rotation=0)));

    equation
      y = (u < 0.1) or (u > 0.5);

    annotation (
      Icon(coordinateSystem(preserveAspectRatio=false),
        graphics={
          Rectangle(extent={{-100,60},{100,-60}}, lineColor={0,0,255}),
          Text(extent={{-90,20},{90,-20}}, textString="OutOfRange", fontSize=12)}),
      Documentation(info="Block outputs true if input u < 0.1 or u > 0.5."));
    end OutOfRangeDetector;

    block SimpleDayNight
      "Outputs true if time of day is between 06:00 and 18:00, else false"
      parameter Real period = 24*3600 "One day = 24 hours [s]";
      Modelica.Blocks.Interfaces.BooleanOutput isDay(start=false)
        "true = day (6h–18h), false = night"
        annotation (Placement(transformation(extent={{100,-10},{120,10}})));

    protected
      Real tDay "Hour of day (0..24)";
    equation
      // Compute current hour of day
      tDay = mod(time, period)/3600;
      // Daytime is 6 <= tDay < 18
      isDay = (tDay >= 6) and (tDay < 18);
      annotation (
        Icon(graphics={
          Rectangle(extent={{-100,-100},{100,100}}, lineColor={0,0,255},
            fillColor={255,255,170}, fillPattern=FillPattern.Solid), Text(
              extent={{-56,26},{56,-16}},
              textColor={28,108,200},
              textString="Day/Night")}),
        Diagram(graphics={
          Text(extent={{-60,40},{60,20}},
            textString="true = 6:00–18:00\nfalse = 18:00–6:00")}));
    end SimpleDayNight;


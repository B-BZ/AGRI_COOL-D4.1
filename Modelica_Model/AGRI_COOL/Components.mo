                        "",
                    fileName=
                        "modelica://AGRI_COOL/AGRICOOL/Icons/CropSource_Icon.png")}),
                Diagram(coordinateSystem(preserveAspectRatio=false)),
              experiment(StopTime=172800, __Dymola_Algorithm="Dassl"));
          end Product_Model;

          model Controller3
            parameter Real T_Threshold = 1 "Temperature difference threshold for activation";
            parameter Real Transfer_Time=10 "the time in which all the mass from tank 1 transfers to tank 2";
            Modelica.Blocks.Interfaces.RealInput T1
              annotation (Placement(transformation(extent={{-128,68},{-88,108}})));
            Modelica.Blocks.Interfaces.RealInput T2
              annotation (Placement(transformation(extent={{-128,26},{-88,66}})));
            Modelica.Blocks.Interfaces.RealInput m_T1
              annotation (Placement(transformation(extent={{-130,-52},{-90,-12}})));
            Modelica.Blocks.Interfaces.RealOutput FlowSignal
              annotation (Placement(transformation(extent={{156,20},{176,40}})));
            Modelica.Blocks.Logical.LessEqualThreshold lessEqualThreshold(threshold=
                  T_Threshold)
              annotation (Placement(transformation(extent={{-2,58},{18,78}})));
            Modelica.Blocks.Math.Add TempDiff(k2=-1)
              annotation (Placement(transformation(extent={{-46,58},{-26,78}})));
            Modelica.Blocks.Logical.Switch switch1
              annotation (Placement(transformation(extent={{50,-42},{70,-22}})));
            Modelica.Blocks.Sources.Constant ZeroFlow(k=0) annotation (Placement(
                  transformation(
                  extent={{-10,-10},{10,10}},
                  rotation=270,
                  origin={64,30})));

            Modelica.Blocks.Logical.GreaterThreshold hasMass_T1(threshold=0.001)
              annotation (Placement(transformation(extent={{-46,-44},{-26,-24}})));
            Modelica.Blocks.Logical.Timer timer
              annotation (Placement(transformation(extent={{4,14},{24,34}})));
            Modelica.Blocks.Logical.And transferCondition
              annotation (Placement(transformation(extent={{-2,-22},{18,-2}})));
          // Discrete variable for storing initial mass at the start of transfer
            discrete Real m1_start;
            Real a1;
          discrete Real m2_start;
            Real a2;
            Modelica.Blocks.Math.Product product1
              annotation (Placement(transformation(extent={{20,-70},{40,-50}})));
            Modelica.Blocks.Sources.RealExpression realExpression(y=a1)
              annotation (Placement(transformation(extent={{-6,-72},{14,-52}})));
            Modelica.Blocks.Interfaces.RealInput m_T2
              annotation (Placement(transformation(extent={{-132,-126},{-92,-86}})));
            Modelica.Blocks.Logical.LessEqualThreshold
                                                  lessEqualThreshold1(threshold=1)
              annotation (Placement(transformation(extent={{-48,-116},{-28,-96}})));
            Modelica.Blocks.Logical.Timer timer1
              annotation (Placement(transformation(extent={{2,-108},{22,-88}})));
            Modelica.Blocks.Math.Product product2
              annotation (Placement(transformation(extent={{42,-132},{62,-112}})));
            Modelica.Blocks.Sources.RealExpression realExpression1(y=a2)
              annotation (Placement(transformation(extent={{2,-138},{22,-118}})));
            Modelica.Blocks.Logical.Switch switch2
              annotation (Placement(transformation(extent={{110,-64},{130,-44}})));
          equation
            // Capture initial mass when transfer starts
            when lessEqualThreshold.y then
              m1_start =pre(m_T1);
            end when;
            // Compute flow rate coefficient
            a1 = 2 * m1_start / (Transfer_Time^2);

            when lessEqualThreshold1.y then
              m2_start =pre(m_T2);
            end when;
            // Compute flow rate coefficient
            a2 = 2 * m2_start / (Transfer_Time^2);

            connect(T1, TempDiff.u1) annotation (Line(points={{-108,88},{-54,88},{-54,74},
                    {-48,74}}, color={0,0,127}));
            connect(T2, TempDiff.u2) annotation (Line(points={{-108,46},{-54,46},{-54,62},
                    {-48,62}}, color={0,0,127}));
            connect(TempDiff.y, lessEqualThreshold.u)
              annotation (Line(points={{-25,68},{-4,68}}, color={0,0,127}));
            connect(ZeroFlow.y, switch1.u3) annotation (Line(points={{64,19},{42,19},{42,12},
                    {24,12},{24,-40},{48,-40}},       color={0,0,127}));
            connect(m_T1, hasMass_T1.u) annotation (Line(points={{-110,-32},{-80,-32},{-80,
                    -34},{-48,-34}}, color={0,0,127}));
            connect(lessEqualThreshold.y, transferCondition.u1) annotation (Line(points={{19,68},
                    {30,68},{30,0},{-16,0},{-16,-12},{-4,-12}},            color={255,0,255}));
            connect(hasMass_T1.y, transferCondition.u2) annotation (Line(points={{-25,-34},
                    {-12,-34},{-12,-20},{-4,-20}}, color={255,0,255}));
            connect(transferCondition.y, switch1.u2) annotation (Line(points={{19,-12},{30,
                    -12},{30,-32},{48,-32}}, color={255,0,255}));
            connect(timer.y, product1.u1) annotation (Line(points={{25,24},{28,24},{28,-38},
                    {18,-38},{18,-54}}, color={0,0,127}));
            connect(realExpression.y, product1.u2)
              annotation (Line(points={{15,-62},{18,-62},{18,-66}}, color={0,0,127}));
            connect(lessEqualThreshold.y, timer.u) annotation (Line(points={{19,68},{26,68},
                    {26,36},{-8,36},{-8,24},{2,24}},
                                                   color={255,0,255}));
            connect(m_T2, lessEqualThreshold1.u) annotation (Line(points={{-112,-106},
                    {-50,-106}}, color={0,0,127}));
            connect(product1.y, switch1.u1) annotation (Line(points={{41,-60},{42,-60},{42,
                    -24},{48,-24}}, color={0,0,127}));
            connect(lessEqualThreshold1.y, timer1.u) annotation (Line(points={{-27,
                    -106},{-10,-106},{-10,-98},{0,-98}}, color={255,0,255}));
            connect(timer1.y, product2.u1)
              annotation (Line(points={{23,-98},{40,-98},{40,-116}}, color={0,0,127}));
            connect(lessEqualThreshold1.y, switch2.u2) annotation (Line(points={{
                    -27,-106},{-10,-106},{-10,-76},{98,-76},{98,-54},{108,-54}},
                  color={255,0,255}));
            connect(switch2.y, FlowSignal) annotation (Line(points={{131,-54},{
                    131,30},{166,30}}, color={0,0,127}));
            connect(realExpression1.y, product2.u2)
              annotation (Line(points={{23,-128},{40,-128}}, color={0,0,127}));
            connect(switch1.y, switch2.u3) annotation (Line(points={{71,-32},{76,
                    -32},{76,-62},{108,-62},{108,-62}}, color={0,0,127}));
            connect(product2.y, switch2.u1) annotation (Line(points={{63,-122},{
                    76,-122},{76,-118},{90,-118},{90,-46},{108,-46}}, color={0,0,
                    127}));
            annotation (Icon(coordinateSystem(preserveAspectRatio=false, extent={{-100,-140},
                      {160,100}}),                                        graphics={
                    Rectangle(
                    extent={{-100,100},{100,-100}},
                    lineColor={28,108,200},
                    fillColor={255,255,255},
                    fillPattern=FillPattern.Solid), Text(
                    extent={{-70,46},{62,-42}},
                    textColor={28,108,200},
                    textString="Controller")}), Diagram(coordinateSystem(
                    preserveAspectRatio=false, extent={{-100,-140},{160,100}})));
          end Controller3;

          model Test_all2
            CropSourcee cropSourcee(T(displayUnit="degC") = 303.15)
              annotation (Placement(transformation(extent={{-62,40},{-42,60}})));
            Tank tank1(
              m_Initial=10,
              T_Initial=288.15,
              cp=3500)
              annotation (Placement(transformation(extent={{-26,22},{-6,42}})));
            Tank tank2(
              m_Initial=50,
              T_Initial=283.15,
              cp=3500)
              annotation (Placement(transformation(extent={{26,4},{46,24}})));
            Controller3 controller3_1(T_Threshold=1, Transfer_Time=100)
              annotation (Placement(transformation(extent={{-8,-18},{12,2}})));
            Modelica.Blocks.Sources.Pulse pulse(
              amplitude=0.2777778,
              width=2.0833333,
              period(displayUnit="h") = 86400,
              offset=0,
              startTime(displayUnit="h") = 28800)
              annotation (Placement(transformation(extent={{-94,40},{-74,60}})));
            Modelica.Thermal.HeatTransfer.Components.ThermalConductor
              thermalConductor(G=200)
              annotation (Placement(transformation(extent={{-36,4},{-56,24}})));
            Modelica.Thermal.HeatTransfer.Components.ThermalConductor
              thermalConductor1(G=200)
              annotation (Placement(transformation(extent={{40,-22},{60,-2}})));
            Modelica.Thermal.HeatTransfer.Sources.FixedTemperature
              fixedTemperature(T=243.15)
              annotation (Placement(transformation(extent={{-90,-4},{-70,16}})));
            Modelica.Blocks.Sources.Pulse pulse1(
              amplitude=0.133334,
              width=2.0833333,
              period(displayUnit="h") = 86400,
              offset=0,
              startTime(displayUnit="h") = 61200)
              annotation (Placement(transformation(extent={{-12,-64},{8,-44}})));
          equation
            connect(cropSourcee.crop_Outflow, tank1.crop_Inflow) annotation (Line(
                points={{-41,50},{-40,50},{-40,39},{-25.4,39}},
                color={0,140,72},
                thickness=1));
            connect(pulse.y, cropSourcee.m) annotation (Line(points={{-73,50},{
                    -72,49.9},{-62.1,49.9}}, color={0,0,127}));
            connect(tank1.Sensor_T, controller3_1.T1) annotation (Line(points={{
                    -5.4,27.2},{4,27.2},{4,8},{-26,8},{-26,1},{-8.61538,1}},
                  color={0,0,127}));
            connect(tank2.Sensor_T, controller3_1.T2) annotation (Line(points={{
                    46.6,9.2},{66,9.2},{66,-36},{-26,-36},{-26,-2.5},{-8.61538,
                    -2.5}}, color={0,0,127}));
            connect(tank1.crop_Outflow, tank2.crop_Inflow) annotation (Line(
                points={{-5.4,39},{8,39},{8,38},{22,38},{22,30},{26.6,30},{26.6,
                    21}},
                color={0,140,72},
                thickness=1));
            connect(tank1.Heat, thermalConductor.port_a) annotation (Line(points=
                    {{-16,22},{-16,14},{-36,14}}, color={191,0,0}));
            connect(tank2.Heat, thermalConductor1.port_a) annotation (Line(points
                  ={{36,4},{36,-12},{40,-12}}, color={191,0,0}));
            connect(fixedTemperature.port, thermalConductor.port_b) annotation (
                Line(points={{-70,6},{-56,6},{-56,14}}, color={191,0,0}));
            connect(fixedTemperature.port, thermalConductor1.port_b) annotation (
                Line(points={{-70,6},{-68,6},{-68,-44},{74,-44},{74,-12},{60,-12}},
                  color={191,0,0}));
            connect(controller3_1.FlowSignal, tank1.Flow_signal) annotation (Line(
                  points={{12.4615,-3.83333},{14,-3.83333},{14,20},{-26.3,20},{
                    -26.3,26.7}}, color={0,0,127}));
            connect(tank1.Sensor_m, controller3_1.m_T1) annotation (Line(points={
                    {-5.4,29.6},{8,29.6},{8,4},{-18,4},{-18,-9},{-8.76923,-9}},
                  color={0,0,127}));
            connect(tank2.Sensor_m, controller3_1.m_T2) annotation (Line(points={{46.6,
                    11.6},{54,11.6},{54,-2},{20,-2},{20,-26},{-22,-26},{-22,-16},
                    {-8.92308,-16},{-8.92308,-15.1667}},      color={0,0,127}));
            connect(pulse1.y, tank2.Flow_signal) annotation (Line(points={{9,-54},
                    {18,-54},{18,-48},{25.7,-48},{25.7,8.7}}, color={0,0,127}));
            annotation (Icon(coordinateSystem(preserveAspectRatio=false)),
                Diagram(coordinateSystem(preserveAspectRatio=false)),
              experiment(StopTime=172800, __Dymola_Algorithm="Dassl"));
          end Test_all2;

          model Controller4
            parameter Real T_Threshold = 1 "Temperature difference threshold for activation";
            parameter Real Transfer_Time = 10 "Time to transfer all mass from Tank 1 to Tank 2";

            // Inputs
            Modelica.Blocks.Interfaces.RealInput T1 "Temperature of Tank 1"
              annotation (Placement(transformation(extent={{-130,80},{-90,120}})));
            Modelica.Blocks.Interfaces.RealInput T2 "Temperature of Tank 2"
              annotation (Placement(transformation(extent={{-130,40},{-90,80}})));
            Modelica.Blocks.Interfaces.RealInput m_T1 "Mass in Tank 1"
              annotation (Placement(transformation(extent={{-130,-20},{-90,20}})));
            Modelica.Blocks.Interfaces.RealInput m_T2 "Mass in Tank 2"
              annotation (Placement(transformation(extent={{-130,-80},{-90,-40}})));

            // Output
            Modelica.Blocks.Interfaces.RealOutput FlowSignal "Output flow signal for transfer"
              annotation (Placement(transformation(extent={{160,20},{180,40}})));

            // Components
            Modelica.Blocks.Logical.LessEqualThreshold tempCondition(threshold = T_Threshold)
              annotation (Placement(transformation(extent={{-20,60},{0,80}})));
            Modelica.Blocks.Math.Add tempDifference(k2 = -1)
              annotation (Placement(transformation(extent={{-60,60},{-40,80}})));
            Modelica.Blocks.Logical.LessThreshold massCondition(threshold = 0.001)
              annotation (Placement(transformation(extent={{-20,-60},{0,-40}})));
            Modelica.Blocks.Math.Product flowFromT1
              annotation (Placement(transformation(extent={{40,60},{60,80}})));
            Modelica.Blocks.Math.Product flowFromT2
              annotation (Placement(transformation(extent={{40,-60},{60,-40}})));
            Modelica.Blocks.Logical.Or fallbackCondition
              annotation (Placement(transformation(extent={{20,0},{40,20}})));
            Modelica.Blocks.Logical.Switch flowSwitch
              annotation (Placement(transformation(extent={{100,0},{120,20}})));
            Modelica.Blocks.Sources.RealExpression flowRateT1(y=a1)
              annotation (Placement(transformation(extent={{-40,30},{-20,50}})));
            Modelica.Blocks.Sources.RealExpression flowRateT2(y=a2)
              annotation (Placement(transformation(extent={{-40,-50},{-20,-30}})));
            Modelica.Blocks.Sources.Constant zeroFlow(k=0)
              annotation (Placement(transformation(extent={{140,10},{160,30}})));

            // Variables
            discrete Real m1_start "Initial mass in Tank 1";
            discrete Real m2_start "Initial mass in Tank 2";
            Real a1 "Flow coefficient for Tank 1";
            Real a2 "Flow coefficient for Tank 2";

          equation
            // Capture initial mass for Tank 1
            when tempCondition.y then
              m1_start = pre(m_T1);
            end when;
            // Compute flow coefficient for Tank 1
            a1 = m1_start / Transfer_Time;
            // Capture initial mass for Tank 2
            when massCondition.y then
              m2_start = pre(m_T2);
            end when;
            // Compute flow coefficient for Tank 2
            a2 = m2_start / Transfer_Time;
            // Connections for Temperature-Based Transfer
            connect(T1, tempDifference.u1) annotation (Line(points={{-110,100},{
                    -50,100},{-50,76},{-62,76}},                                                            color={0,0,127}));
            connect(T2, tempDifference.u2) annotation (Line(points={{-110,60},{
                    -50,60},{-50,64},{-62,64}},                                                           color={0,0,127}));
            connect(tempDifference.y, tempCondition.u) annotation (Line(points={{-39,70},
                    {-22,70}},                                                                      color={0,0,127}));
            connect(tempCondition.y, flowRateT1.y) annotation (Line(points={{1,70},{
                    -10,70},{-10,40},{-19,40}},                                              color={255,0,255}));
            connect(flowRateT1.y, flowFromT1.u1) annotation (Line(points={{-19,40},
                    {20,40},{20,76},{38,76}},                                               color={0,0,127}));
            // Connections for Mass-Based Transfer
            connect(m_T2, massCondition.u) annotation (Line(points={{-110,-60},{
                    -66,-60},{-66,-50},{-22,-50}},                                        color={0,0,127}));
            connect(massCondition.y, flowRateT2.y) annotation (Line(points={{1,-50},
                    {-10,-50},{-10,-40},{-19,-40}},                                            color={255,0,255}));

    model Test_TwoCircuitChiller
      extends Modelica.Icons.Example;
      extends AGRI_COOL.Components.Base_Classes.Medium_Definition;

      TwoCircuitChiller twoCircuitChiller(redeclare package Medium_Evap =
            Medium_HTF, redeclare package Medium_Cond = Medium_Air)
        annotation (Placement(transformation(extent={{-10,-10},{10,10}})));
      Buildings.Fluid.Sources.MassFlowSource_T souCon(
        redeclare package Medium = Medium_Air,
        use_T_in=true,
        m_flow=3.34,
        T=298.15,
        nPorts=2) "Condenser source"
        annotation (Placement(transformation(extent={{-76,10},{-56,30}})));
      Buildings.Fluid.Sources.Boundary_pT sinEva(redeclare package Medium =
            Medium_HTF, nPorts=1)     "Evaporator sink" annotation (
          Placement(transformation(extent={{-10,-10},{10,10}}, origin={-74,-40})));
      Modelica.Blocks.Sources.SawTooth ySet(
        amplitude=-1,
        period=500,
        offset=1,
        startTime=500)  "Compressor control signal"
        annotation (Placement(transformation(extent={{-116,-24},{-96,-4}})));
      Modelica.Blocks.Sources.Ramp TConIn(
        height=5,
        duration=60,
        offset=273.15 + 30,
        startTime=60) "Condenser inlet temperature"
        annotation (Placement(transformation(extent={{-126,10},{-106,30}})));
      Modelica.Blocks.Sources.BooleanStep chiCoo(startTime=2100, startValue=
            true)
        "Chilling mode on"
        annotation (Placement(transformation(extent={{-84,-80},{-64,-60}})));
      Buildings.Fluid.Sources.MassFlowSource_T souEva(
        nPorts=1,
        redeclare package Medium = Medium_HTF,
        use_T_in=true,
        m_flow=0.343,
        T=291.15) "Evaporator source"
        annotation (Placement(transformation(extent={{54,-14},{34,6}})));
      Buildings.Fluid.Sources.Boundary_pT sinCon(redeclare package Medium =
            Medium_Air, nPorts=2)     "Condenser sink" annotation (
          Placement(transformation(extent={{10,-10},{-10,10}}, origin={64,32})));
      Modelica.Blocks.Sources.Ramp TEvaIn(
        height=5,
        duration=60,
        startTime=900,
        offset=273.15)      "Evaporator inlet temperature"
        annotation (Placement(transformation(extent={{48,-48},{68,-28}})));
      Modelica.Blocks.Sources.Pulse pulse(
        amplitude=0.8,
        width=50,
        period=3600*2,
        offset=0.1)
        annotation (Placement(transformation(extent={{-136,-52},{-116,-32}})));
      Buildings.Fluid.Sensors.TemperatureTwoPort TIT_001(redeclare package
          Medium = Medium_HTF, m_flow_nominal=1)
        annotation (Placement(transformation(extent={{-24,-10},{-44,10}})));
    equation
      connect(TConIn.y,souCon. T_in) annotation (Line(
          points={{-105,20},{-88,20},{-88,24},{-78,24}},
          color={0,0,127},
          smooth=Smooth.None));
      connect(TEvaIn.y,souEva. T_in) annotation (Line(
          points={{69,-38},{74,-38},{74,0},{56,0}},
          color={0,0,127},
          smooth=Smooth.None));
      connect(souCon.ports[1], twoCircuitChiller.Cond_Inlet_C2) annotation (
          Line(points={{-56,19},{-7.4,19},{-7.4,10}}, color={0,127,255}));
      connect(souCon.ports[2], twoCircuitChiller.Cond_Inlet_C1) annotation (
          Line(points={{-56,21},{-8,21},{-8,14},{-4.8,14},{-4.8,10}}, color={0,
              127,255}));
      connect(souEva.ports[1], twoCircuitChiller.Evap_inlet_C1) annotation (
          Line(points={{34,-4},{16,-4},{16,0},{10.2,0}}, color={0,127,255}));
      connect(twoCircuitChiller.Cond_outlet_C1, sinCon.ports[1]) annotation (
          Line(points={{4.4,10},{4.4,31},{54,31}}, color={0,127,255}));
      connect(twoCircuitChiller.Cond_outlet_C2, sinCon.ports[2]) annotation (
          Line(points={{1.8,10},{1.8,14},{4,14},{4,33},{54,33}}, color={0,127,
              255}));
      connect(twoCircuitChiller.Evap_outlet_C2, TIT_001.port_a) annotation (
          Line(points={{-10,-0.6},{-17,-0.6},{-17,0},{-24,0}}, color={0,127,255}));
      connect(TIT_001.port_b, sinEva.ports[1]) annotation (Line(points={{-44,0},
              {-54,0},{-54,-40},{-64,-40}}, color={0,127,255}));
      connect(pulse.y, twoCircuitChiller.ySet_C2) annotation (Line(points={{
              -115,-42},{-88,-42},{-88,-54},{-20,-54},{-20,-3.6},{-10.8,-3.6}},
            color={0,0,127}));
      connect(pulse.y, twoCircuitChiller.ySet_C1) annotation (Line(points={{
              -115,-42},{-88,-42},{-88,-54},{-20,-54},{-20,-8},{-10.8,-8}},
            color={0,0,127}));
      annotation (Icon(coordinateSystem(preserveAspectRatio=false)), Diagram(
            coordinateSystem(preserveAspectRatio=false)),
        experiment(StopTime=18000, __Dymola_Algorithm="Dassl"));
    end Test_TwoCircuitChiller;
  end Chiller;

  package PV
    model PvPanels
      "PV array: N modules in parallel; total power is sum(pv[i].P). All share same weather and AC terminal."

      // ===== User-set parameters =====
      parameter Integer nPV(min=1) = 4 "Number of PV modules";
      parameter Real A = 1.63 "Module area [m2]";
      parameter Real fAct = 0.89 "Active area fraction [-]";
      parameter Real eta = 0.14 "Module efficiency [-]";
      parameter Real til = 0.175 "≈10° tilt [rad]";
      parameter Real azi = 0.0   "Due south [rad]";

      parameter Real V_nominal = 29.7 "Nominal AC terminal voltage [V]";
      parameter Modelica.Units.SI.Frequency f = 60 "AC frequency [Hz]";

      // ===== Weather + fixed AC source =====
      AGRI_COOL.Buildings.Electrical.AC.OnePhase.Sources.FixedVoltage sou(
        f=f, V=V_nominal) "Common AC terminal for all PV modules"
        annotation (Placement(transformation(extent={{-120,-10},{-100,10}})));

      // ===== PV modules (array) =====
      AGRI_COOL.Buildings.Electrical.AC.OnePhase.Sources.PVSimpleOriented pv[nPV](
        each A=A, each fAct=fAct, each eta=eta,
        each til=til, each azi=azi, each V_nominal=V_nominal)
        "Identical PV modules wired in parallel to the same AC terminal"
        annotation (Placement(transformation(extent={{-10,60},{30,120}})));

      // ===== Outputs =====
      // Total power as a connector (signal)
      Modelica.Blocks.Interfaces.RealOutput P_total
        "Total array power = sum(pv[i].P) [W]"
        annotation (Placement(transformation(extent={{126,-12},{146,8}}),
            iconTransformation(extent={{126,-12},{146,8}})));

      // (Optional) expose per-module power; uncomment if you want it
      // Modelica.Blocks.Interfaces.RealOutput P_each[nPV] "Per-module power [W]";
      // Block to sum real signals
      Modelica.Blocks.Math.Sum sumP(nin=nPV) "Summation of pv[i].P signals";

      AGRI_COOL.Buildings.BoundaryConditions.WeatherData.Bus
                                         weaBus "Weather data" annotation (
         Placement(transformation(extent={{-86,76},{-66,96}}), iconTransformation(
              extent={{-136,72},{-94,106}})));
    equation
      // --- Weather bus: same bus to every PV
      for i in 1:nPV loop
        connect(weaBus, pv[i].weaBus);
      end for;
      // --- Electrical: all PV terminals to the same fixed-voltage terminal (parallel)
      for i in 1:nPV loop
        connect(pv[i].terminal, sou.terminal);
      end for;
      // --- Power sum: wire pv[i].P -> sum block -> total output
      for i in 1:nPV loop
        connect(pv[i].P, sumP.u[i]);
        // connect(pv[i].P, P_each[i]); // (optional) per-module power
      end for;
      connect(sumP.y, P_total);

      annotation (
        Documentation(info="
<p>This model instantiates <code>nPV</code> PV modules, all connected to the same weather bus and a shared fixed-voltage AC terminal. The per-module power outputs <code>pv[i].P</code> are summed to produce <code>P_total</code>.</p>
<ul>
  <li><b>nPV</b> — number of modules</li>
  <li><b>P_total</b> — total array power [W]</li>
</ul>
<p>If you need per-module power signals, uncomment <code>P_each</code> and its connections.</p>"),
        Icon(coordinateSystem(preserveAspectRatio=true, extent={{-160,-120},{160,120}}),
            graphics={
            Polygon(
              points={{-108,0},{-60,115},{50,115},{1,0},{-108,0}},

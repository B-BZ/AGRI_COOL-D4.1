    model FanCoil_closedLoop "Performance benchmark of fan coil"

      replaceable package Medium_L=Buildings.Media.Air
        "Load side medium";
     replaceable package Medium_HTF =
            AGRI_COOL.Buildings.Media.Antifreeze.EthyleneGlycolWater(property_T = 273.15,X_a=0.4)
       "Source side medium";

     parameter Modelica.Units.SI.Temperature T_aCoWat_nominal(
        min=273.15,
        displayUnit="degC") = 273.15 + 1
        "Cooling water inlet temperature at nominal conditions"
        annotation (Dialog(group="Nominal condition"));
      parameter Modelica.Units.SI.Temperature T_bCoWat_nominal(
        min=273.15,
       displayUnit="degC") = T_aCoWat_nominal + 5
        "Cooling water outlet temperature at nominal conditions"
        annotation (Dialog(group="Nominal condition"));
      parameter Modelica.Units.SI.Temperature T_aLoaCo_nominal(
        min=273.15,
        displayUnit="degC") = 273.15 + 5
        "Load side inlet temperature at nominal conditions in cooling mode (zone inlet T)"
        annotation (Dialog(group="Nominal condition"));
      parameter Modelica.Units.SI.Temperature T_bLoaCo_nominal(
        min=273.15,
        displayUnit="degC") = T_aLoaCo_nominal + 5
        "Load side outlet temperature at nominal conditions in cooling mode (zone outlet T)"
        annotation (Dialog(group="Nominal condition"));
      parameter Modelica.Units.SI.MassFlowRate mLoaCo_flow_nominal(min=0) =
        2500/1005/2.5
        "Load side mass flow rate at nominal conditions"
        annotation (Dialog(group="Nominal condition"));
      parameter Modelica.Units.SI.MassFlowRate mChilWat_flow_nominal(min=0) =
        0.5
        "water side mass flow rate at nominal conditions"
        annotation (Dialog(group="Nominal condition"));

      parameter Modelica.Units.SI.HeatFlowRate QCo_flow_nominal=
          -2500 "Design cooling flow rate (<=0)"
        annotation (Dialog(group="Nominal condition"));

      parameter Modelica.Units.SI.MassFraction w_aLoaCoo_nominal(min=0) = 0.01
      "Nominal humidity ratio (kg water vapor / kg dry air)"
      annotation (Dialog(group="Nominal condition"));
     parameter Modelica.Units.SI.PressureDifference dpLoa_nominal(displayUnit="Pa")=
           250 "Load side pressure drop"
        annotation (Dialog(group="Nominal condition"));
     parameter Modelica.Units.SI.PressureDifference dpNominal_ChilWat_fanCoil(displayUnit="Pa")=
           25000 "Load side pressure drop"
        annotation (Dialog(group="Nominal condition"));

      //////
     import hexConfiguration=AGRI_COOL.Buildings.Fluid.Types.HeatExchangerConfiguration;
       final parameter hexConfiguration hexConCoo=hexConfiguration.CounterFlow
        "Cooling heat exchanger configuration";
        parameter Boolean allowFlowReversal=true
        "Set to true to allow flow reversal in building distribution system"
        annotation (Dialog(tab="Assumptions"),Evaluate=true);
      parameter Boolean allowFlowReversalLoa=true
        "Set to true to allow flow reversal on the load side"
        annotation (Dialog(tab="Assumptions"),Evaluate=true);
      //////
     parameter Real facMulZon(min=Modelica.Constants.eps)=1
        "Zone multiplier factor";
      parameter Real facMul=1
        "Multiplier factor";
       parameter Integer nLoa=1
        "Number of served loads"
        annotation (Evaluate=true);

      Buildings.Fluid.Movers.Preconfigured.SpeedControlled_y
                                                   fan(
        redeclare final package Medium = Medium_L,
        T_start=288.15,
        final allowFlowReversal=allowFlowReversalLoa,
        addPowerToMedium=true,
        final m_flow_nominal=mLoaCo_flow_nominal,
        energyDynamics=Modelica.Fluid.Types.Dynamics.SteadyState,
        use_riseTime=false,
        final dp_nominal=dpLoa_nominal) "Fan"
        annotation (Placement(transformation(extent={{84,-28},{64,-8}})));
      Buildings.Fluid.HeatExchangers.WetCoilEffectivenessNTU
                                                   hexWetNtu(
        redeclare final package Medium1 = Medium_HTF,
        redeclare final package Medium2 = Medium_L,
        show_T=true,
        final configuration=hexConCoo,
        final m1_flow_nominal=mChilWat_flow_nominal,
        final m2_flow_nominal=mLoaCo_flow_nominal,
        final dp1_nominal=dpNominal_ChilWat_fanCoil,
        final dp2_nominal=dpLoa_nominal,
        use_Q_flow_nominal=true,
        final Q_flow_nominal=QCo_flow_nominal,
        final T_a1_nominal=T_aCoWat_nominal,
        final T_a2_nominal=T_bLoaCo_nominal,
        final allowFlowReversal1=allowFlowReversal,
        final allowFlowReversal2=allowFlowReversalLoa,
        final w_a2_nominal=0.01,
        energyDynamics=Modelica.Fluid.Types.Dynamics.FixedInitial)
        "Cooling coil"
        annotation (Placement(transformation(extent={{-38,-44},{-18,-64}})));
        //final Q_flow_nominal=3*QCo_flow_nominal,
      //w_aLoaCoo_nominal
      Buildings.Fluid.FixedResistances.PressureDrop
                                          resLoa(
        redeclare final package Medium = Medium_L,
        final allowFlowReversal=allowFlowReversalLoa,
        final m_flow_nominal=mLoaCo_flow_nominal,
        final dp_nominal=dpLoa_nominal)
        "Load side pressure drop"
        annotation (Placement(transformation(extent={{136,-30},{116,-10}})));
      Modelica.Fluid.Interfaces.FluidPort_a port_aLoa(
        redeclare final package Medium = Medium_L,
        p(start=Medium_L.p_default),
        m_flow(min=if allowFlowReversalLoa then -Modelica.Constants.inf else 0),
        h_outflow(start=Medium_L.h_default, nominal=Medium_L.h_default))
        "Fluid stream inlet port on the load side"
        annotation (Placement(transformation(extent={{148,70},{168,90}}),
        iconTransformation(extent={{150,98},{170,118}})));

      Modelica.Fluid.Interfaces.FluidPort_b port_bLoa(
        redeclare final package Medium = Medium_L,
        p(start=Medium_L.p_default),
        m_flow(max=if allowFlowReversalLoa then +Modelica.Constants.inf else 0),
        h_outflow(start=Medium_L.h_default, nominal=Medium_L.h_default))
        "Fluid stream outlet port on the load side"
        annotation (Placement(transformation(extent={{-148,68},{-168,88}}),
        iconTransformation(extent={{-152,102},{-172,122}})));

      Modelica.Fluid.Interfaces.FluidPort_a port_aChiWat(
        p(start=Medium_HTF.p_default),
        redeclare final package Medium = Medium_HTF,
        m_flow(min=if allowFlowReversal then -Modelica.Constants.inf else 0),
        h_outflow(start=Medium_HTF.h_default, nominal=Medium_HTF.h_default))
        "Chilled water inlet port"
        annotation (Placement(transformation(extent={{-170,-112},{-150,-92}}),
          iconTransformation(extent={{-168,-100},{-148,-80}})));

      Modelica.Fluid.Interfaces.FluidPort_b port_bChiWat(
      p(start=Medium_HTF.p_default),
        redeclare final package Medium = Medium_HTF,
        m_flow(max=if allowFlowReversal then +Modelica.Constants.inf else 0),
        h_outflow(start=Medium_HTF.h_default, nominal=Medium_HTF.h_default))
        "Chilled water outlet port"
        annotation (Placement(transformation(extent={{170,-110},{150,-90}}), iconTransformation(extent={{170,-98},
                {150,-78}})));

      Modelica.Blocks.Interfaces.RealInput TSetCoo(
        final quantity="ThermodynamicTemperature",
        final unit="K",
        displayUnit="degC") "Cooling set point"
        annotation (Placement(transformation(extent={{-20,-20},{20,20}},rotation=0,origin={-166,120}),
        iconTransformation(extent={{-10,-10},{10,10}},rotation=0,origin={-156,64})));
      Buildings.Controls.OBC.CDL.Reals.PIDWithReset con(
        final k=1,
        final Ti=10,
        controllerType=Buildings.Controls.OBC.CDL.Types.SimpleController.PI,
        yMax=1,
        yMin=0,
        final reverseActing=false) "PI controller"
        annotation (Placement(transformation(extent={{-68,146},{-48,166}})));
      Modelica.Blocks.Interfaces.RealInput TColdRoom(
        final quantity="ThermodynamicTemperature",
        final unit="K",
        displayUnit="degC")  "Cooling set point"
        annotation (Placement(transformation(
            extent={{-20,-20},{20,20}},
            rotation=0,
            origin={-166,0}),  iconTransformation(
            extent={{-10,-10},{10,10}},
            rotation=0,
            origin={-158,-20})));
      Modelica.Blocks.Sources.BooleanExpression booleanExpression
        annotation (Placement(transformation(extent={{-86,124},{-66,144}})));
      AGRI_COOL.Components.Unit_Cooler.DiscreteFanWithDeadbandDelay discreteFanWithDeadbandDelay(
          updatePeriod=3*60, heldFanSpeed(fixed=true, start=1))
        annotation (Placement(transformation(extent={{58,40},{86,68}})));
      Buildings.Fluid.Sensors.TemperatureTwoPort senTem_AirInCoil(redeclare
          package
          Medium =         Medium_L, m_flow_nominal=mLoaCo_flow_nominal)
        annotation (Placement(transformation(extent={{52,-32},{32,-12}})));
      Buildings.Fluid.Sensors.TemperatureTwoPort senTem_AirOutCoil(redeclare

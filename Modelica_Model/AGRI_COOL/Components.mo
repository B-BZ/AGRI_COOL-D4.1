              annotation (Placement(transformation(extent={{-90,-4},{-70,16}})));
            Modelica.Blocks.Sources.Constant const(k=0)
              annotation (Placement(transformation(extent={{-10,-74},{10,-54}})));
          equation
            connect(cropSourcee.crop_Outflow, tank1.crop_Inflow) annotation (Line(
                points={{-41,50},{-40,50},{-40,39},{-25.4,39}},
                color={0,140,72},
                thickness=1));
            connect(pulse.y, cropSourcee.m) annotation (Line(points={{-73,50},{
                    -72,49.9},{-62.1,49.9}}, color={0,0,127}));
            connect(tank1.Sensor_T, controller2.T1) annotation (Line(points={{
                    -5.4,27.2},{4,27.2},{4,8},{-26,8},{-26,-2},{-8.6,-2}}, color=

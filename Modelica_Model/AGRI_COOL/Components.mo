                  Transfer_Time)
              annotation (Placement(transformation(extent={{-8,-18},{12,2}})));
            Modelica.Blocks.Interfaces.RealInput m_In
              annotation (Placement(transformation(extent={{-126,30},{-86,70}})));
            Modelica.Blocks.Interfaces.RealInput m_Out
              annotation (Placement(transformation(extent={{132,-80},{92,-40}})));
            parameter Modelica.Units.SI.ThermalConductance G_tank1=200
              "Constant thermal conductance of material";
            parameter Modelica.Units.SI.ThermalConductance G_Tank2=100
              "Constant thermal conductance of material";
            parameter Modelica.Units.SI.Mass m_Initial_T1=10
              annotation (Dialog(group="Tank1"));
            parameter Modelica.Units.SI.Temperature T_Initial_T1=288.15
              "Initial temperature [degC]" annotation (Dialog(group="Tank 1"));
            parameter Modelica.Units.SI.Mass m_Initial_T2=50
              annotation (Dialog(group="Tank2"));
            parameter Modelica.Units.SI.Temperature T_Initial_T2=283.15
              "Initial temperature [degC]" annotation (Dialog(group="Tank2"));
            parameter Real T_Threshold=1
              "Temperature difference threshold for activation";
            parameter Real Transfer_Time=1800
              "the time in which all the mass from tank 1 transfers to tank 2";
            Modelica.Blocks.Sources.RealExpression realExpression(y=
                  tank_enthalpy_TCR.m + tank_enthalpy_TCR1.m)
              annotation (Placement(transformation(extent={{56,54},{76,74}})));
            Modelica.Blocks.Interfaces.RealOutput m_total "Value of Real output"
              annotation (Placement(transformation(extent={{98,54},{118,74}})));
            parameter Modelica.Units.SI.Temperature T(displayUnit="degC") =
              303.15 "Temperature [K]";
            parameter Real cp=3500 "Specific heat capacity [J/(kg.K)]";
            parameter Modelica.Units.SI.SpecificHeatCapacity cp_T1=3500
              "Specific heat capacity (assumed constant)"
              annotation (Dialog(group="Tank1"));
            parameter Modelica.Units.SI.SpecificHeatCapacity cp_T2=3500
              "Specific heat capacity (assumed constant)"
              annotation (Dialog(group="Tank2"));
            m_check m_check1 annotation (Placement(transformation(extent={{50,-70},
                      {28,-50}})));
            m_outFlow_Check m_outFlow_Check1
              annotation (Placement(transformation(extent={{0,36},{20,56}})));
            Modelica.Blocks.Interfaces.RealInput T_CR annotation (Placement(
                  transformation(extent={{-128,-26},{-88,14}})));
            Modelica.Blocks.Math.Add add
              annotation (Placement(transformation(extent={{68,32},{88,52}})));
            Modelica.Blocks.Interfaces.RealOutput Q_Product_Total
              "Connector of Real output signal" annotation (Placement(
                  transformation(extent={{100,-14},{120,6}})));
            parameter Real Ts=100;
          equation
            connect(cropSourcee.crop_Outflow, tank_enthalpy_TCR.crop_Inflow)
              annotation (Line(
                points={{-41,50},{-40,50},{-40,39},{-25.4,39}},
                color={0,140,72},
                smooth=Smooth.Bezier,
                thickness=0.5));
            connect(tank_enthalpy_TCR.Sensor_T, controller2_1_1.T1) annotation (
               Line(points={{-5.4,27.2},{4,27.2},{4,8},{-26,8},{-26,-2},{-8.6,-2}},
                  color={0,0,127}));
            connect(tank_enthalpy_TCR1.Sensor_T, controller2_1_1.T2)
              annotation (Line(points={{46.6,9.2},{66,9.2},{66,-36},{-26,-36},{
                    -26,-6.2},{-8.6,-6.2}}, color={0,0,127}));
            connect(controller2_1_1.FlowSignal, tank_enthalpy_TCR.Flow_signal)
              annotation (Line(points={{12.6,-10.2},{14,-10.2},{14,20},{-26.3,
                    20},{-26.3,26.7}}, color={0,0,127}));
            connect(cropSourcee.m, m_In) annotation (Line(points={{-62.1,49.9},{
                    -106,49.9},{-106,50}}, color={0,0,127}));
            connect(realExpression.y, m_total)
              annotation (Line(points={{77,64},{108,64}}, color={0,0,127}));
            connect(m_Out, m_check1.m_out) annotation (Line(points={{112,-60},{
                    62,-60},{62,-53.2},{50.88,-53.2}}, color={0,0,127}));
            connect(tank_enthalpy_TCR1.Sensor_m, m_check1.m2) annotation (Line(
                  points={{46.6,11.6},{62,11.6},{62,12},{76,12},{76,-68},{50.66,
                    -68},{50.66,-66.8}}, color={0,0,127}));
            connect(tank_enthalpy_TCR.Sensor_m, m_check1.m1) annotation (Line(
                  points={{-5.4,29.6},{28,29.6},{28,30},{66,30},{66,-64},{50.88,
                    -64},{50.88,-62.8}}, color={0,0,127}));
            connect(m_check1.m2_FlowSignal, tank_enthalpy_TCR1.Flow_signal)
              annotation (Line(points={{27.34,-56},{26,-56},{26,0},{22,0},{22,
                    8.7},{25.7,8.7}}, color={0,0,127}));
            connect(tank_enthalpy_TCR.Sensor_m, controller2_1_1.m1) annotation (
               Line(points={{-5.4,29.6},{-8.8,29.6},{-8.8,-14}}, color={0,0,127}));
            connect(m_check1.m1_FlowSignal, controller2_1_1.m_out) annotation (
                Line(points={{27.34,-64},{18,-64},{18,2},{16,2},{16,3},{3.6,3}},
                  color={0,0,127}));
            connect(tank_enthalpy_TCR.crop_Outflow, m_outFlow_Check1.crop_Inflow)
              annotation (Line(
                points={{-5.4,39},{-5.4,40},{0.6,40},{0.6,46}},
                color={0,140,72},
                thickness=1));
            connect(m_outFlow_Check1.crop_Outflow, tank_enthalpy_TCR1.crop_Inflow)
              annotation (Line(
                points={{20.6,46},{28,46},{28,28},{22,28},{22,21},{26.6,21}},
                color={0,140,72},
                thickness=1));
            connect(controller2_1_1.Tank_Emptying_Signal, m_outFlow_Check1.u)
              annotation (Line(points={{12.6,-1.8},{12.6,56.6},{10,56.6}},
                  color={255,0,255}));
            connect(controller2_1_1.FlowSignal, m_outFlow_Check1.Flow_signal)
              annotation (Line(points={{12.6,-10.2},{9.8,-10.2},{9.8,35.4}},
                  color={0,0,127}));
            connect(T_CR, tank_enthalpy_TCR.T_CR) annotation (Line(points={{
                    -108,-6},{-32,-6},{-32,34.5},{-26.5,34.5}}, color={0,0,127}));
            connect(T_CR, tank_enthalpy_TCR1.T_CR) annotation (Line(points={{
                    -108,-6},{-28,-6},{-28,-8},{-16,-8},{-16,-22},{20,-22},{20,
                    16.5},{25.5,16.5}}, color={0,0,127}));
            connect(tank_enthalpy_TCR1.Q_Total, add.u2) annotation (Line(points
                  ={{46.6,17},{50,17},{50,36},{66,36}}, color={0,0,127}));
            connect(tank_enthalpy_TCR.Q_Total, add.u1) annotation (Line(points=
                    {{-5.4,35},{-5.4,64},{50,64},{50,48},{66,48}}, color={0,0,
                    127}));
            connect(add.y, Q_Product_Total) annotation (Line(points={{89,42},{
                    96,42},{96,-4},{110,-4}}, color={0,0,127}));
            annotation (Icon(coordinateSystem(preserveAspectRatio=false),
                  graphics={Bitmap(
                    extent={{-100,-102},{98,100}},
                    imageSource=
                        "",
                    fileName=
                        "modelica://AGRI_COOL/AGRICOOL/Icons/CropSource_Icon.png")}),
                Diagram(coordinateSystem(preserveAspectRatio=false)),
              experiment(StopTime=172800, __Dymola_Algorithm="Dassl"));
          end Product_Model_T_CR;
        end Components;

        package Algorithm_Based
          model ProductBatch
            import Modelica.Units.SI.*;

            parameter Mass m_start = 0 "Initial mass of this batch";
            parameter SpecificHeatCapacity cp_p = 3000 "Specific heat capacity of product [J/(kg.K)]";
            parameter ThermalConductance G = 10 "Conductance between batch and air [W/K]";
            parameter Real T_Strt_Tar = 25;

            Temperature T(start=273.15+30, fixed=true);
            discrete Mass m(start=m_start, fixed=true);
            discrete Boolean occupied(start=false, fixed=true);
            discrete Temperature T_target(start=273.15+T_Strt_Tar, fixed=true);
            //parameter Temperature T_target(start=273.15, fixed=true);
            discrete Boolean justArrived(start=false, fixed=true);

            Modelica.Thermal.HeatTransfer.Interfaces.HeatPort_a port
              annotation (
                Placement(transformation(
                  extent={{-10,-10},{10,10}},
                  origin={60,0})));

          equation
            // When a batch just arrives, force temperature to target immediately
            when justArrived then
              reinit(T, pre(T_target));
            end when;

            // Heat transfer dynamics
            if occupied and m > 0 then
              m * cp_p * der(T) = G * (port.T - T);
              port.Q_flow = G * (port.T - T);
            else
              der(T) = 0;
              port.Q_flow = 0;
            end if;

          annotation (
            Icon(graphics={
                Rectangle(
                  extent={{-60,40},{60,-40}},
                  lineColor={0,0,255},
                  fillColor={230,230,255},
                  fillPattern=FillPattern.Solid),
                Text(
                  extent={{-50,10},{50,-10}},
                  textString="Product\nBatch",
                  horizontalAlignment=TextAlignment.Center),
                Ellipse(
                  extent={{70,10},{90,-10}},
                  lineColor={255,0,0},
                  fillColor={255,200,200},
                  fillPattern=FillPattern.Solid)}),
            Diagram(graphics={
                Rectangle(
                  extent={{-60,40},{60,-40}},
                  lineColor={0,0,255},
                  fillColor={255,255,255},
                  fillPattern=FillPattern.Solid),
                Text(extent={{-50,10},{50,-10}},
                  textString="Product Batch"),
                Ellipse(
                  extent={{70,10},{90,-10}},
                  lineColor={255,0,0},
                  fillColor={255,200,200},
                  fillPattern=FillPattern.Solid),
                Text(extent={{90,10},{120,-10}},
                     textString="port")}),
              Documentation(info="<html>
<p><h4>A batch model</p><p>T target is important as it initiated the temperature of new product arrival</h4></p>
</html>"));
          end ProductBatch;

          model ProductInventoryFIFO_periodically
            import Modelica.Units.SI.*;
            import Modelica.Thermal.HeatTransfer.Interfaces.HeatPort_a;

            parameter SpecificHeatCapacity cp_p = 3000;
            parameter ThermalConductance G_each = 10;

            // Periodic arrival/removal parameters
            parameter Time dayDuration = 86400 "Duration of one day in seconds (24 hours)";
            parameter Time arrivalTimes[2] = {28800, 57600} "Arrival times within a day (8:00 and 16:00)";
            parameter Time removalTimes[2] = {36000, 64800} "Removal times within a day (10:00 and 18:00)";

            parameter Mass arrivalMass[2] = {100, 150} "Mass arriving each time";
            parameter Temperature arrivalTemp[2] = {310, 310} "Temperature of arriving products";
            parameter Mass removalMass[2] = {80, 170} "Mass removed each time";

             Mass m_total;

            AGRI_COOL.Components.Cooling_Loads.Product_Load.Sensible.Algorithm_Based.ProductBatch batch1(cp_p=cp_p, G=G_each);
            AGRI_COOL.Components.Cooling_Loads.Product_Load.Sensible.Algorithm_Based.ProductBatch batch2(cp_p=cp_p, G=G_each);
            AGRI_COOL.Components.Cooling_Loads.Product_Load.Sensible.Algorithm_Based.ProductBatch batch3(cp_p=cp_p, G=G_each);

            HeatPort_a port annotation(Placement(
                transformation(
                  extent={{-10,-10},{10,10}},
                  origin={90,0})));

            discrete Integer nextArrivalIndex(start=1, fixed=false);
            discrete Integer nextRemovalIndex(start=1, fixed=false);
            discrete Time nextArrivalTime(fixed=false);
            discrete Time nextRemovalTime(fixed=false);
            Mass toRemove;
            //aligns the simulation start time with your daily schedule using inital algorithm (this fixed the issue if simulation
             // starts from any day than 0)
          initial algorithm
            // Calculate first arrival time based on current simulation start time
            nextArrivalTime := time + mod(arrivalTimes[1] - mod(time, dayDuration) + dayDuration, dayDuration);
            if nextArrivalTime - time < 1e-6 then
              nextArrivalTime := nextArrivalTime + dayDuration;
            end if;

            // Check if second arrival time of the day comes sooner
            if mod(time, dayDuration) >= arrivalTimes[1] and mod(time, dayDuration) < arrivalTimes[2] then
              nextArrivalTime := time + (arrivalTimes[2] - mod(time, dayDuration));
              nextArrivalIndex := 2;
            end if;

            // Calculate first removal time based on current simulation start time
            nextRemovalTime := time + mod(removalTimes[1] - mod(time, dayDuration) + dayDuration, dayDuration);
            if nextRemovalTime - time < 1e-6 then
              nextRemovalTime := nextRemovalTime + dayDuration;
            end if;

            // Check if second removal time of the day comes sooner
            if mod(time, dayDuration) >= removalTimes[1] and mod(time, dayDuration) < removalTimes[2] then
              nextRemovalTime := time + (removalTimes[2] - mod(time, dayDuration));
              nextRemovalIndex := 2;
            end if;

          equation
            // Connect all batch heat ports to the main port
            connect(port, batch1.port);
            connect(port, batch2.port);
            connect(port, batch3.port);
            m_total = batch1.m + batch2.m + batch3.m;

          algorithm
            // ==================================================
            // ARRIVAL EVENTS (Periodic - twice per day)
            // ==================================================
            when time >= nextArrivalTime then
              // Find first free batch and assign
              if not pre(batch1.occupied) then
                batch1.m := arrivalMass[pre(nextArrivalIndex)];
                batch1.T_target := arrivalTemp[pre(nextArrivalIndex)];
                batch1.occupied := true;
                batch1.justArrived := true;
              elseif not pre(batch2.occupied) then
                batch2.m := arrivalMass[pre(nextArrivalIndex)];
                batch2.T_target := arrivalTemp[pre(nextArrivalIndex)];
                batch2.occupied := true;
                batch2.justArrived := true;
              elseif not pre(batch3.occupied) then
                batch3.m := arrivalMass[pre(nextArrivalIndex)];
                batch3.T_target := arrivalTemp[pre(nextArrivalIndex)];
                batch3.occupied := true;
                batch3.justArrived := true;
              else
                assert(false, "No free batch slot for arrival at time " + String(time));
              end if;

              // Schedule next arrival
              if pre(nextArrivalIndex) == 1 then
                nextArrivalIndex := 2;
                nextArrivalTime := pre(nextArrivalTime) + (arrivalTimes[2] - arrivalTimes[1]);
              else
                nextArrivalIndex := 1;
                nextArrivalTime := pre(nextArrivalTime) + (dayDuration - arrivalTimes[2] + arrivalTimes[1]);
              end if;
            end when;

            // Reset justArrived flags
            when pre(batch1.justArrived) then
              batch1.justArrived := false;
            end when;
            when pre(batch2.justArrived) then
              batch2.justArrived := false;
            end when;
            when pre(batch3.justArrived) then
              batch3.justArrived := false;
            end when;

            // ==================================================
            // REMOVAL EVENTS (FIFO with cascading removal - Periodic twice per day)
            // ==================================================
            when time >= nextRemovalTime then
              toRemove := removalMass[pre(nextRemovalIndex)];

              // Try to remove from batch1 first
              if pre(batch1.occupied) then
                if toRemove >= pre(batch1.m) then
                  toRemove := toRemove - pre(batch1.m);
                  batch1.m := 0;
                  batch1.occupied := false;
                else
                  batch1.m := pre(batch1.m) - toRemove;
                  toRemove := 0;
                end if;
              end if;

              // If still material to remove, continue with batch2
              if pre(batch2.occupied) and toRemove > 0 then
                if toRemove >= pre(batch2.m) then
                  toRemove := toRemove - pre(batch2.m);
                  batch2.m := 0;
                  batch2.occupied := false;
                else
                  batch2.m := pre(batch2.m) - toRemove;
                  toRemove := 0;
                end if;
              end if;

              // If still material to remove, continue with batch3
              if pre(batch3.occupied) and toRemove > 0 then
                if toRemove >= pre(batch3.m) then
                  toRemove := toRemove - pre(batch3.m);
                  batch3.m := 0;
                  batch3.occupied := false;
                else
                  batch3.m := pre(batch3.m) - toRemove;
                  toRemove := 0;
                end if;
              end if;

              // Warn if couldn't remove all requested material
              if toRemove > 0 then
                assert(false, "Insufficient inventory: " + String(toRemove) +
                       " kg could not be removed at time " + String(time));
              end if;

              // Schedule next removal
              if pre(nextRemovalIndex) == 1 then
                nextRemovalIndex := 2;
                nextRemovalTime := pre(nextRemovalTime) + (removalTimes[2] - removalTimes[1]);
              else
                nextRemovalIndex := 1;
                nextRemovalTime := pre(nextRemovalTime) + (dayDuration - removalTimes[2] + removalTimes[1]);
              end if;
            end when;

            annotation (Documentation(info="<html>
<p>Model: ProductInventoryFIFO_periodically</p>
<p>This model represents an inventory of up to three product batches that arrive and are removed at fixed times twice per day. Each batch has thermal behavior and is connected to a common thermal port representing the storage environment.</p>
<p>Main Features:</p>
<ul>
<li>Two arrivals per day at arrivalTimes[1] and arrivalTimes[2], each with specified mass and temperature.</li>
<li>Two removals per day at removalTimes[1] and removalTimes[2], each with a specified mass to remove.</li>
<li>FIFO removal logic: material is always taken first from batch1, then batch2, then batch3.</li>
<li>Automatic scheduling of arrival and removal events based on the current simulation time and the daily cycle.</li>
<li>Uses discrete-event modeling with &apos;when&apos; clauses for arrivals, removals, and flags like justArrived.</li>
<li>Includes error checking for full inventory during arrivals and insufficient inventory during removals.</li>
</ul>
<p>Algorithm and Methodology:</p>
<ol>
<li>Daily Scheduling Logic:<br>The model uses mod(time, dayDuration) to determine the simulation time within the current day. It then computes whether today&apos;s or tomorrow&apos;s arrival/removal should be the next event. nextArrivalTime and nextRemovalTime are initialized according to the current time.</li>
<li>Arrival Events:<br>At each arrival event, the defined mass and temperature of product arrive. The model checks the batches in order:</li>
<li>batch1</li>
<li>batch2</li>
<li>batch3<br>The first free (unoccupied) batch receives the new product. The mass and target temperature are assigned, and the justArrived flag is set for one event step. After processing an arrival, the model schedules the next arrival event.</li>
<li>Removal Events (FIFO):<br>At each removal event, the requested mass to remove is stored in toRemove. The model removes mass strictly in FIFO order:</li>
<li>First from batch1</li>
<li>If still needed, from batch2</li>
<li>If still needed, from batch3<br>If a batch contains less mass than required, it is emptied and marked unoccupied, and the model continues to the next batch. If the total inventory is insufficient to satisfy the requested removal, an assertion error is triggered. After completing the removal, the model schedules the next removal event.</li>
<li>Thermal Behavior:<br>All batches share the same thermal port, meaning they exchange heat with the same thermal environment. The temperature evolution inside each ProductBatch is continuous, while the inventory operations are discrete.</li>
</ol>
<p>Parameters:</p>
<ul>
<li>cp_p: specific heat capacity of the product.</li>
<li>G_each: thermal conductance between each batch and the environment.</li>
<li>dayDuration: duration of one simulated day (normally 86400 seconds).</li>
<li>arrivalTimes: times of the two daily arrivals.</li>
<li>arrivalMass, arrivalTemp: mass and temperature of each arrival event.</li>
<li>removalTimes: times of the two daily removals.</li>
<li>removalMass: mass to be removed at each removal event.</li>
</ul>
<p>Purpose:</p><p>This model is intended for simulating periodic delivery and withdrawal of stored products where both thermal modeling and discrete inventory logic are important, such as food storage, thermal buffering materials, or warehouse temperature studies.</p>
</html>"));
          end ProductInventoryFIFO_periodically;
        end Algorithm_Based;
      end Sensible;

      package Respiration
        model Respiration
          Modelica.Blocks.Interfaces.RealInput T_in_K
            annotation (Placement(transformation(extent={{-130,50},{-90,90}})));
            Modelica.Blocks.Interfaces.RealOutput Q_Respiration annotation (Placement(
                transformation(extent={{94,-20},{128,14}}), iconTransformation(extent={{
                    94,-20},{128,14}})));
          Modelica.Blocks.Interfaces.RealInput m_pr
            annotation (Placement(transformation(extent={{-128,-78},{-88,-38}})));
          parameter Real a = 19.092 "Respiration parameter (a)";
          parameter Real b = 0.076 "Respiration parameter (b)";
        equation
          Q_Respiration = 0.001 * m_pr * a * exp(b * (T_in_K - 273.15));
          // Parameters
          // Respiration load equation
          annotation (Icon(coordinateSystem(preserveAspectRatio=false),
                graphics={
                Polygon(
                  points={{-10,-92},{-46,-86},{-62,-56},{-60,-10},{-40,-28},{
                      -22,-40},{-10,-66},{-10,-92}},
                  lineColor={0,140,72},
                  lineThickness=1,
                  smooth=Smooth.Bezier,
                  fillColor={0,186,93},
                  fillPattern=FillPattern.Solid),
                Polygon(
                  points={{10,-90},{46,-84},{62,-54},{60,-8},{40,-26},{22,-38},
                      {10,-64},{10,-90}},
                  lineColor={0,140,72},
                  lineThickness=1,
                  smooth=Smooth.Bezier,
                  fillColor={0,186,93},
                  fillPattern=FillPattern.Solid),
                Polygon(
                  points={{0,-52},{-4,-44},{-16,-32},{-16,-2},{-2,24},{20,-10},
                      {12,-38},{0,-52}},
                  lineColor={0,140,72},
                  lineThickness=1,
                  smooth=Smooth.Bezier,
                  fillColor={0,186,93},
                  fillPattern=FillPattern.Solid),
                Line(
                  points={{-42,82},{-58,62},{-42,42},{-54,16},{-46,0}},
                  color={28,108,200},
                  thickness=1,
                  smooth=Smooth.Bezier),
                Line(
                  points={{-8,82},{2,64},{-8,46},{-2,28}},
                  color={28,108,200},
                  thickness=1,
                  smooth=Smooth.Bezier),
                Line(
                  points={{30,82},{46,62},{30,42},{42,16},{34,0}},
                  color={28,108,200},
                  thickness=1,
                  smooth=Smooth.Bezier)}),
              Diagram(coordinateSystem(preserveAspectRatio=false)));
        end Respiration;
      end Respiration;
    end Product_Load;

    package Lighting
      model Lighting
        // Parameters
        parameter Real lighting_power_density(unit="W/m2") = 6 "Lighting power density";
        parameter Real floor_area(unit="m2") = 50 "Floor area of the cold room";

        // Inputs
        Modelica.Blocks.Interfaces.RealInput lights_on "Lights on (1 = on, 0 = off)"
          annotation (Placement(transformation(extent={{-130,50},{-90,90}})));

        // Output
        Modelica.Blocks.Interfaces.RealOutput Q_Lighting "Lighting cooling load (W)"
          annotation (Placement(transformation(extent={{94,-20},{128,14}})));

      equation
        // Lighting cooling load calculation
        Q_Lighting = lighting_power_density * floor_area * lights_on;

        annotation (
          Icon(coordinateSystem(preserveAspectRatio=false), graphics={Polygon(
                points={{-18,20},{18,20},{14,22},{44,-44},{2,-88},{-48,-58},{

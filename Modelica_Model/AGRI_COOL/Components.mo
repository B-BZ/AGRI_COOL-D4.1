    end FanCoil;

    model DiscreteFanWithDeadband
       Modelica.Blocks.Interfaces.RealInput T_set "Temperature setpoint" annotation (Placement(transformation(extent={{-158,10},{-118,52}})));
       Modelica.Blocks.Interfaces.RealInput T_room "Room temperature" annotation (Placement(transformation(extent={{-156,
                -50},{-116,-8}})));

      Modelica.Blocks.Interfaces.RealOutput fanSpeed "Discrete fan speed (0.0 to 1.0)" annotation (Placement(transformation(extent={{96,-12},
                {136,30}})));

      Real dT "Temperature difference";
      parameter Real DB = 0.25 "Deadband value";
      Modelica.Blocks.Logical.Hysteresis h25(uHigh=0 + DB, uLow=0);
      Modelica.Blocks.Logical.Hysteresis h50(uHigh=0.25 + DB, uLow=0.25);
      Modelica.Blocks.Logical.Hysteresis h75(uHigh=0.5 + DB, uLow=0.5);
      Modelica.Blocks.Logical.Hysteresis h100(uHigh=0.75 + DB, uLow=0.75);

      Boolean b25, b50, b75, b100;

    equation
      dT =T_room - T_set;
      // Feed delta T into hysteresis thresholds
      h25.u = dT;
      h50.u = dT;
      h75.u = dT;
      h100.u = dT;

      b25 = h25.y;
      b50 = h50.y;
      b75 = h75.y;
      b100 = h100.y;
      // Discrete fan output selection
      fanSpeed = if b100 then 1.0
                 else if b75 then 0.75
                 else if b50 then 0.5
                 else if b25 then 0.25
                 else 0.0;

    end DiscreteFanWithDeadband;

    model DiscreteFanWithDeadbandDelay
      parameter Real DB = 0.25 "Deadband value";
      parameter Real updatePeriod = 60 "Update period in seconds";
      // 1 minute default
      Modelica.Blocks.Interfaces.RealInput T_set "Temperature setpoint"
        annotation (Placement(transformation(extent={{-158,10},{-118,52}})));
      Modelica.Blocks.Interfaces.RealInput T_room "Room temperature"
        annotation (Placement(transformation(extent={{-156,-50},{-116,-8}})));
      Modelica.Blocks.Interfaces.RealOutput fanSpeed "Discrete fan speed (0.0 to 1.0)"
        annotation (Placement(transformation(extent={{96,-12},{136,30}})));

      Real dT "Temperature difference";

      Modelica.Blocks.Logical.Hysteresis h25(uHigh=0 + DB,    uLow=0);
      Modelica.Blocks.Logical.Hysteresis h50(uHigh=0.25 + DB, uLow=0.25);
      Modelica.Blocks.Logical.Hysteresis h75(uHigh=0.5 + DB,  uLow=0.5);
      Modelica.Blocks.Logical.Hysteresis h100(uHigh=0.75 + DB, uLow=0.75);

      Boolean b25, b50, b75, b100;
      Real rawFanSpeed "Instantaneous fan speed from hysteresis logic";

      // Hold last updated value
      discrete Real heldFanSpeed(start=0);

    equation
      dT = T_room - T_set+0.5;
      // Feed delta T into hysteresis thresholds
      h25.u = dT;
      h50.u = dT;
      h75.u = dT;
      h100.u = dT;

      b25 = h25.y;
      b50 = h50.y;
      b75 = h75.y;
      b100 = h100.y;
      // Discrete fan output selection (instantaneous)
      rawFanSpeed = if b100 then 1.0
                    else if b75 then 0.75
                    else if b50 then 0.5
                    else if b25 then 0.25
                    else 0.0;
      // Update only every updatePeriod seconds
      when sample(0, updatePeriod) then
        heldFanSpeed = rawFanSpeed;
      end when;

      fanSpeed = heldFanSpeed;

    end DiscreteFanWithDeadbandDelay;

